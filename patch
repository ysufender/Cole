+pub fn determineComptimeReturnType(
+    self: *Folder,
+    returnExpr: defines.ExpressionPtr,
+    functionExpr: defines.ExpressionPtr,
+    args: []const defines.ExpressionPtr,
+    argTypes: []const TypeID,
+) Error!TypeID {
