import std::io::stream as IO;
import std::io;
import std::io::stream::ostream as Output;

import std::string as String;
import std::memory::allocator as Allocator;
import std::io::console as Console;
import std::c;

let Option = fn (T: type) -> type {
    return union(enum) {
        Some: T,
        None: void,
    };
};

pub let Value = union(enum) {
    Int: mut c_long,
    String: mut []u8,
    Bool: mut bool,

    pub let Maybe = Option(Value);

    pub let tagName = [4][]u8(
        "Int",
        "String",
        "Bool",
    );

    pub let toStr = fn (self: Value, allocator: Allocator::Allocator) -> []u8 {
        return switch self {
            @Int -> |val| String::intToStr(val, allocator),
            @String -> |val| val,
            @Bool -> |val| if (val) "true" else "false",

        };
    };
};

pub let KeyValuePair = struct {
    key: []u8,
    value: mut Value,
    desc: []u8,
};

pub let Args = struct {
    pairs: mut []mut KeyValuePair,
    capacity: u32,

    /* error in this function */
    pub let get = fn (self: *Args, key: []u8) -> Value::Maybe {
        for self.pairs, |pair| {
            if String::equals(key, pair.key) {
                return (@Some, pair.value);
            }
        }

        return (@None, ());
    };
};

pub let init = fn (gpa: Allocator::Allocator, count: u32) -> Args {
    let mem: []mut KeyValuePair = unsafeCast(Allocator::alloc(gpa, count, sizeOf(KeyValuePair)));

    return (mem[0..0], count);
};

pub let option = fn (self: *mut Args, name: []u8, def: bool, desc: []u8) -> bool {

    if self.pairs.len >= self.capacity {
        return true;
    }

    let index = self.pairs.len;
    self.pairs = self.pairs[0..index + 1];
    self.pairs[index] = (name, (@Bool, def), desc);

    return false;
};

pub let param = fn (self: *mut Args, name: []u8, def: Value, desc: []u8) -> bool {

    if self.pairs.len >= self.capacity {
        return true;
    }

    let index = self.pairs.len;
    self.pairs = self.pairs[0..index + 1];
    self.pairs[index] = (name, def, desc);


    return false;
};

pub let help = fn (self: *Args, stream: IO::Output::Stream, allocator: Allocator::Allocator) -> void {
    _ = Output::writeline(stream, "usage: jedy [parameters]");

    for self.pairs, |pair| {
        _ = Output::writebuffer(stream, "    ");
        _ = Output::writebuffer(stream, pair.key);
        _ = Output::writebuffer(stream, ": <");
        _ = Output::writebuffer(stream, Value::tagName[as(u32, pair.value.tag)]);
        _ = Output::writebuffer(stream, "> ");
        _ = Output::writeline(stream, pair.desc);
        _ = Output::writebuffer(stream, "        (default = ");
        _ = Output::writebuffer(stream, Value::toStr(pair.value, allocator));
        _ = Output::writeline(stream, ")");
    }
};

pub let parse = fn (self: mut *mut Args, args: [][]u8, stream: IO::Output::Stream, allocator: Allocator::Allocator) -> bool {

    let set = fn (_self: mut *mut Args, _name: []u8, _value: Value) -> bool {
        for 0.._self.pairs.len, |index| {
            if String::equals(_self.pairs[index].key, _name) {
                if _self.pairs[index].value.tag != _value.tag {
                    return true;

                }


                _self.pairs[index].&.value = _value;

            }
        }

        return true;
    };

    for 0..args.len, |index| {
        let arg = args[index].&;
        if arg.*[0] == '-' {
            let param = arg.*[1..arg.len];
            /*            error in this call */
            let x = Args::get(self, param);
            switch x {
                @None -> if String::equals(param, "help") {
                    help(self, stream, allocator);
                }
                @Some -> |val| switch val {
                    @Bool -> _ = set(self, param, (@Bool, true));
                    @String -> _ = set(self, param, (@String, args[index + 1]));
                    else -> { }
                }
            }
        }
    }


    return false;

};
