let print = fn (msg: []u8) -> void {
    asm {
        #include <stdio.h>
        printf("%s", msg.ptr);
    }
};

let println = fn (msg: []u8) -> void {
    asm {
        #include <stdio.h>
        printf("%s\n", msg.ptr);
    }
};

let main = fn () -> i32 {
    println("Hello World");
    return 1;
};
