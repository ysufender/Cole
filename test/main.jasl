import raylib;

let main = fn () -> i32 {
    raylib::InitWindow(600, 500, "Hello World");

    while !raylib::WindowShouldClose() {
        let delta = raylib::GetFrameTime();

        raylib::BeginDrawing();
        {
            raylib::ClearBackground(raylib::Red);
            raylib::DrawText(
                "Hello World",
                275, 240, 20,
                raylib::Blue,
            );
            raylib::DrawCircle((160.0, 160.0), 15, raylib::Blue);
        }
        raylib::EndDrawing();
    }

    raylib::CloseWindow();

    return 0;
};
