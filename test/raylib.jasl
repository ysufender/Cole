/*
 * RayLib bindings.
 */

asm {
    #include "raylib.h"
}

pub let Vector2 = #(@extern) struct {
    pub x: float,
    pub y: float,
};

pub let Color = #(@extern) struct {
    pub r: u8,
    pub g: u8,
    pub b: u8,
    pub a: u8,
};

pub let Rectangle = #(@extern) struct {
    x     : float,
    y     : float,
    width : float,
    height: float,
};

pub let InitWindow = fn (width: i32, height: i32, title: []u8) -> void {
    asm { InitWindow(width, height, (char const*)title.ptr); }
};

pub let WindowShouldClose = fn () -> bool {
    let res: mut bool = #(@noComptime) false;
    asm { res = WindowShouldClose(); }
    return res;
};

pub let CloseWindow = fn () -> void {
    asm { CloseWindow(); }
};
