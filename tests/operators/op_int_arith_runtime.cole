import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let main = fn (args: [][]u8) -> i32 {
    let a: i32 = #(@noComptime) 7;
    let b: i32 = #(@noComptime) 3;
    pi(a + b);
    pi(a - b);
    pi(a * b);
    pi(a / b);
    pi(a % b);

    let n: i32 = #(@noComptime) -5;
    pi(n * b);
    pi(n / b);
    pi(n % b);
    pi(n + b);
    pi(n - b);
    return 0;
};
