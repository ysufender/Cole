// operators/op_precedence_implemented
// Pins the precedence the parser implements for bitwise, shift and modulo operators.
// NOTE: This documents the parser (or < and < == != < | < ^ < & < comparison < shift < + - < * / < %). It differs from Appendix II of the language reference; see bugs/bug_precedence_documented.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};
let pb = fn (b: bool) -> void {
    Console::log(String::boolToStr(b));
};

let main = fn (args: [][]u8) -> i32 {
    pi(1 + 2 << 1);
    pi(6 & 3 + 1);
    pi(1 | 2 ^ 3);
    pi(2 * 3 % 4);
    pb(3 & 1 == 1);
    return 0;
};
