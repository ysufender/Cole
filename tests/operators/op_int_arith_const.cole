// operators/op_int_arith_const
// Integer arithmetic on compile-time constants.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let main = fn (args: [][]u8) -> i32 {
    pi(7 + 3);
    pi(7 - 3);
    pi(7 * 3);
    pi(7 / 3);
    pi(7 % 3);
    pi(100 / 10 / 5);
    pi(10 - 4 - 3);
    pi(2 * 3 + 4 * 5);
    return 0;
};
