// comptime/comptime_src_info
// src() reports the line and column of the call site.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let main = fn (args: [][]u8) -> i32 {
    let a = src().line;
    let b = src().line;
    pi(b - a);
    let c = src().col;
    pi(c);
    return 0;
};
