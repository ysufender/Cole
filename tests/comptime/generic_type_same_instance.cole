import std::io::console as Console;

let Box = fn (T: type) -> type {
    return struct {
        value: T,
        count: u8,
    };
};

let A = Box(i32);
let B = Box(i32);

let take = fn (b: A) -> i32 {
    return b.value;
};

let main = fn (args: [][]u8) -> i32 {
    let b = B(9, 1);
    if A != B {
        Console::log("types are not the same: ok");
    }
    if Box(i32) == Box(i32) {
        Console::log("anon types are the same: ok");
    }
    return 0;
};
