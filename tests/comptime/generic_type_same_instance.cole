import std::io::console as Console;

let Box = fn (T: type) -> type {
    return struct {
        value: T,
        count: u8,
    };
};

let A = Box(i32);
let B = Box(i32);

let take = fn (b: A) -> i32 {
    return b.value;
};

let main = fn (args: [][]u8) -> i32 {
    let b = B(9, 1);
    if take(b) == 9 {
        Console::log("same instance: ok");
    }
    if A == B {
        Console::log("types are same: ok");
    }
    return 0;
};
