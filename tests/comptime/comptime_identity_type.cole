// comptime/comptime_identity_type
// A comptime function can simply return its type argument.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let Id = fn (T: type) -> type {
    return T;
};

let main = fn (args: [][]u8) -> i32 {
    let x: Id(i32) = 5;
    pi(x);
    let y: Id(u8) = 200;
    pi(y);
    return 0;
};
