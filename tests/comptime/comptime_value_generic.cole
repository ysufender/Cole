// comptime/comptime_value_generic
// Comptime functions can take value parameters as well as types.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let Buf = fn (T: type, N: comptime_int) -> type {
    return struct { items: [N]T, count: u32 };
};

let main = fn (args: [][]u8) -> i32 {
    let B = Buf(i32, 3);
    let b = B((1, 2, 3), 3);
    pi(b.items[1]);
    pi(b.items.len);
    pi(b.count);
    return 0;
};
