// comptime/comptime_typeinfo_struct
// typeInfo exposes the fields of a struct.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};
let pb = fn (b: bool) -> void {
    Console::log(String::boolToStr(b));
};

let P = struct { a: i32, b: u8 };

let main = fn (args: [][]u8) -> i32 {
    pi(typeInfo(P).Struct.fields.len);
    Console::log(typeInfo(P).Struct.fields[0].name);
    Console::log(typeInfo(P).Struct.fields[1].name);
    Console::log(typeName(typeInfo(P).Struct.fields[1].valueType));
    pb(typeInfo(P).Struct.isTuple);
    return 0;
};
