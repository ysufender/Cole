// comptime/comptime_sizeof_struct
// sizeOf, alignOf and bitSizeOf agree with the C layout of a struct.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let S = struct { a: i32, b: u8 };

let main = fn (args: [][]u8) -> i32 {
    pi(sizeOf(S));
    pi(alignOf(S));
    pi(sizeOf(i32) + sizeOf(u8));
    return 0;
};
