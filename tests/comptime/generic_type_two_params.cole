import std::io::console as Console;
import std;

let IF = std::Pair(i32, float);
let FI = std::Pair(float, i32);

let main = fn (args: [][]u8) -> i32 {
    let p = IF(1, 2.5);
    let q = FI(1.5, 3);

    if p.second == 2.5 {
        Console::log("IF.second: ok");
    }
    if q.second == 3 {
        Console::log("FI.second: ok");
    }

    return 0;
};
