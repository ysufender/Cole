import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let main = fn (args: [][]u8) -> i32 {
    for #(@inline) 0..4, |i| {
        pi(i);
    }
    Console::log("-");
    for #(@inline) 3..6, |i| {
        pi(i);
    }
    Console::log("-");
    for #(@inline) 5..5, |i| {
        pi(i);
    }
    Console::log("-");
    for #(@inline) 0..6, |i| {
        if i == 2 { continue; }
        pi(i);
    }
    Console::log("-");
    for #(@inline) 0..6, |i| {
        if i == 3 { break; }
        pi(i);
    }
    return 0;
};
