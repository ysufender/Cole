import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let Wrapper = fn (T: type) -> type {
    return struct {
        value: T,
        count: u32,

        pub let empty = this()(undefined, 7);
    };
};

let W = Wrapper(u32);

let main = fn (args: [][]u8) -> i32 {
    let e = W::empty;
    pi(e.count);
    return 0;
};
