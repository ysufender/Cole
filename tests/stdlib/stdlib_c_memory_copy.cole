import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

import std::memory::allocator as Alloc;
import std::c::memory as CMem;

let main = fn (args: [][]u8) -> i32 {
    let a = Alloc::alloc(C::Allocator, 4, 1);
    let b = Alloc::alloc(C::Allocator, 4, 1);
    let src: []mut u8 = unsafeCast(a);
    let dst: []mut u8 = unsafeCast(b);
    src[0] = 1;
    src[1] = 2;
    src[2] = 3;
    src[3] = 4;
    dst[0] = 0;
    dst[1] = 0;
    dst[2] = 0;
    dst[3] = 0;
    CMem::copy(dst.ptr, src.ptr, 4);
    pi(dst[0] + dst[1] + dst[2] + dst[3]);
    Alloc::dealloc(C::Allocator, a);
    Alloc::dealloc(C::Allocator, b);
    return 0;
};
