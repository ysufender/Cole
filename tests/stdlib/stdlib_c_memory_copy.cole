import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

import std::memory::allocator;
import std::c::memory as CMem;

let Alloc = std::memory::allocator::Allocator;

let main = fn (args: [][]u8) -> i32 {
    let src = Alloc::alloc(u8)(C::Allocator, 4).Ok;
    let dst = Alloc::alloc(u8)(C::Allocator, 4).Ok;
    src[0] = 1;
    src[1] = 2;
    src[2] = 3;
    src[3] = 4;
    dst[0] = 0;
    dst[1] = 0;
    dst[2] = 0;
    dst[3] = 0;
    CMem::copy(cast(dst.ptr), cast(src.ptr), 4);
    pi(dst[0] + dst[1] + dst[2] + dst[3]);
    Alloc::dealloc(u8)(C::Allocator, src);
    Alloc::dealloc(u8)(C::Allocator, dst);
    return 0;
};
