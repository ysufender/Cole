// stdlib/stdlib_string_parse
// std::string conversions between text, numbers and booleans.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};
let pf = fn (f: float) -> void {
    Console::log(String::floatToStr(f, C::Allocator));
};
let pb = fn (b: bool) -> void {
    Console::log(String::boolToStr(b));
};

import std::string as S;

let main = fn (args: [][]u8) -> i32 {
    pi(S::strToInt("987654"));
    pi(S::strToInt("-0"));
    pf(S::strToFloat("0.5"));
    pf(S::strToFloat("-2.25"));
    Console::log(S::boolToStr(true));
    Console::log(S::boolToStr(false));
    pb(S::strToBool("true"));
    pb(S::strToBool("no"));
    return 0;
};
