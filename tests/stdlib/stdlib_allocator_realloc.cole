import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

import std::memory::allocator as Alloc;

let main = fn (args: [][]u8) -> i32 {
    let mem = Alloc::alloc(C::Allocator, 2, 4);
    let ints: []mut i32 = unsafeCast(mem);
    ints[0] = 11;
    ints[1] = 22;
    let bigger = Alloc::realloc(C::Allocator, mem, 16);
    let more: []mut i32 = unsafeCast(bigger);
    pi(more.len);
    pi(more[0]);
    pi(more[1]);
    Alloc::dealloc(C::Allocator, bigger);
    return 0;
};
