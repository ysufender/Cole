import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

import std::memory::allocator as Alloc;

let main = fn (args: [][]u8) -> i32 {
    let ints = Alloc::alloc(i32)(C::Allocator, 2).Ok;
    ints[0] = 11;
    ints[1] = 22;
    let more = Alloc::realloc(i32)(C::Allocator, ints, 16).Ok;
    pi(more.len);
    pi(more[0]);
    pi(more[1]);
    Alloc::dealloc(i32)(C::Allocator, more);
    return 0;
};
