import std::io as Io;
import std::io::stream as Stream;

let main = fn (args: [][]u8) -> i32 {
    let msg = "hello world";

    for msg, |ch| {
        _ = Stream::Output::write(Io::StdOut(), ch.*);
    }

    _ = Stream::Output::write(Io::StdOut(), 10);

    for 0..11, |i| {
        _ = Stream::Output::write(Io::StdOut(), msg[i]);
    }

    _ = Stream::Output::write(Io::StdOut(), 10);

    return 0;
};
