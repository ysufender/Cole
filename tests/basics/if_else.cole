import std::io::console as Console;

let main = fn (args: [][]u8) -> i32 {
    if false { Console::log("Nope 1"); }
    else if false { Console::log("Nope 2"); }
    else { Console::log("Yep 1"); }

    if true { Console::log("Yep 2"); }
    else { Console::log("Nope 3"); }

    let variable = #(@noComptime) true;
    if variable { Console::log("Hello World"); }

    return 0;
};
