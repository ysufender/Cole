import std::io::console as Console;

let main = fn (args: [][]u8) -> i32 {
    let enm = enum { Some, None };
    switch enm(@Some) {
        @Some -> Console::log("Some");
        else -> Console::log("Unexpected Error");
    }

    switch enm(@None) {
        @Some -> Console::log("Unexpected Error");
        else -> Console::log("None");
    }

    return 0;
};
