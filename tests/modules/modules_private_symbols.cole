// modules/modules_private_symbols
// Private helpers stay reachable through public functions of the same module.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

import modules::lib::util as Util;

let main = fn (args: [][]u8) -> i32 {
    pi(Util::useHidden());
    return 0;
};
