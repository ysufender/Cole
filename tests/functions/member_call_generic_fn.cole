import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let Scale = struct {
    k: i32,

    pub let apply = #(@generic) fn (T: type) -> *fn (Scale, T) -> T {
        return fn (self: Scale, v: T) -> T { return v * self.k; };
    };
};

let main = fn (args: [][]u8) -> i32 {
    let s = Scale(3);
    pi(s.apply(i32)(5));
    pi(s.&.apply(i32)(2));
    return 0;
};
