import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let Box = fn (T: type) -> type {
    return struct {
        value: T,

        let Self = this();

        pub let get = fn (self: *Self) -> T { return self.value; };
        pub let plus = fn (self: Self, k: T) -> T { return self.value + k; };
    };
};

let IntBox = Box(i32);

let main = fn (args: [][]u8) -> i32 {
    let b = IntBox(40);
    pi(b.&.get());
    pi(b.plus(2));
    return 0;
};
