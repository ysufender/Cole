import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let Counter = struct {
    n: mut i32,

    pub let bump = fn (self: *mut Counter) -> void { self.n = self.n + 1; };
    pub let get = fn (self: *Counter) -> i32 { return self.n; };
};

let main = fn (args: [][]u8) -> i32 {
    let c: mut Counter = Counter(0);
    c.&.bump();
    c.&.bump();
    c.&.bump();
    pi(c.&.get());
    pi(c.n);
    return 0;
};
