import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let Point = struct {
    x: i32,
    y: i32,

    pub let byRef = fn (self: *Point) -> i32 { return self.x * self.y; };
    pub let byValue = fn (self: Point) -> i32 { return self.x + self.y; };
};

let main = fn (args: [][]u8) -> i32 {
    let p = Point(3, 4);
    let q = p.&;
    pi(q.byRef());
    pi(q.byValue());
    return 0;
};
