import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let Acc = struct {
    base: i32,

    pub let add = fn (self: Acc, a: i32, b: i32) -> i32 { return self.base + a + b; };
    pub let scale = fn (self: *Acc, k: i32) -> i32 { return self.base * k; };
};

let main = fn (args: [][]u8) -> i32 {
    let a = Acc(100);
    pi(a.add(1, 2));
    pi(a.&.scale(3));
    pi(a.add(a.&.scale(2), 5));
    return 0;
};
