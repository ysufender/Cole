// functions/fn_deep_recursion
// Recursion a thousand levels deep.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let sumTo = fn (n: i32) -> i32 {
    if n == 0 { return 0; }
    return n + sumTo(n - 1);
};

let main = fn (args: [][]u8) -> i32 {
    pi(sumTo(1000));
    return 0;
};
