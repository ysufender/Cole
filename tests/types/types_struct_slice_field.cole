// types/types_struct_slice_field
// A struct can hold a slice (string) field.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let Named = struct {
    name: []u8,
    id: i32,
};

let main = fn (args: [][]u8) -> i32 {
    let n = Named("Cole", 7);
    Console::log(n.name);
    pi(n.id);
    pi(n.name.len);
    return 0;
};
