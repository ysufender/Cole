// types/types_pointer_undefined
// undefined pointers are null; undefined scalars are zero.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};
let pb = fn (b: bool) -> void {
    Console::log(String::boolToStr(b));
};

let main = fn (args: [][]u8) -> i32 {
    let p: *mut i32 = undefined;
    pb(p == undefined);
    let x: mut i32 = 3;
    let q: *mut i32 = x.&;
    pb(q == undefined);
    let z: i32 = undefined;
    pi(z);
    return 0;
};
