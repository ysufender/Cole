// types/types_union_return
// Functions can return tagged unions built from initializer lists.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let Maybe = union(enum) { Some: i32, None: void };

let pick = fn (n: i32) -> Maybe {
    if n > 0 { return (@Some, n); }
    return (@None, ());
};

let main = fn (args: [][]u8) -> i32 {
    switch pick(5) {
        @Some -> |v| pi(v);
        @None -> Console::log("none");
    }
    switch pick(-1) {
        @Some -> |v| pi(v);
        @None -> Console::log("none");
    }
    return 0;
};
