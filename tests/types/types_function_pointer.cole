// types/types_function_pointer
// Functions are values: alias them, store them in typed pointer variables, call through them.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let double = fn (x: i32) -> i32 { return x * 2; };
let inc = fn (x: i32) -> i32 { return x + 1; };

let main = fn (args: [][]u8) -> i32 {
    let h: *fn (i32) -> i32 = inc;
    pi(h(1));
    let g = double;
    pi(g(21));
    let k: *fn (i32) -> i32 = double;
    pi(k(h(3)));
    return 0;
};
