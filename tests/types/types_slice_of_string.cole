import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

import std::io as Io;
import std::io::stream as Stream;

let main = fn (args: [][]u8) -> i32 {
    let word = "slice me";
    let part = word[0..5];
    pi(part.len);
    for part, |c| {
        _ = Stream::Output::write(Io::StdOut(), c);
    }
    _ = Stream::Output::write(Io::StdOut(), 10);
    pi(part[1]);
    return 0;
};
