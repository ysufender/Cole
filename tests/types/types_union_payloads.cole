import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let Dim = struct { w: i32, h: i32 };

let Shape = union(enum) {
    Circle: i32,
    Rect: Dim,
    Empty: void,
};

let area = fn (s: Shape) -> i32 {
    return switch s {
        @Circle -> |r| 3 * r * r,
        @Rect -> |d| d.w * d.h,
        @Empty -> 0,
    };
};

let main = fn (args: [][]u8) -> i32 {
    pi(area(Shape(@Circle, 2)));
    pi(area(Shape(@Rect, Dim(3, 4))));
    pi(area(Shape(@Empty, ())));
    let s: Shape = (@Circle, 5);
    switch s {
        @Circle -> |r| pi(r);
        else -> Console::log("other");
    }
    return 0;
};
