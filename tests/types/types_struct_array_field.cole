// types/types_struct_array_field
// A struct can hold a fixed size array.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let Grid = struct {
    cells: [3]i32,
    n: i32,
};

let main = fn (args: [][]u8) -> i32 {
    let g = Grid((7, 8, 9), 3);
    pi(g.cells[1]);
    pi(g.cells[2]);
    pi(g.n);
    pi(g.cells.len);
    return 0;
};
