// types/types_struct_pointer_mutation
// Mutating a struct through a pointer to a mutable struct.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let Point = struct {
    x: mut i32,
    y: mut i32,
};

let main = fn (args: [][]u8) -> i32 {
    let m: mut Point = (1, 2);
    let p: *mut Point = m.&;
    p.x = 100;
    p.y = 55;
    pi(m.x);
    pi(m.y);
    pi(p.x + p.y);
    return 0;
};
