import std::io::console as Console;

let Opt = fn (T: type) -> type {
    return union(enum) {
        Some: T,
        None: void,
    };
};

let main = fn (args: [][]u8) -> i32 {
    Console::log(typeName(typeInfo(Opt(float)).Union.fields[1].valueType));
    Console::log(typeName(typeInfo(Opt(bool)).Union.fields[1].valueType));
    return 0;
};
