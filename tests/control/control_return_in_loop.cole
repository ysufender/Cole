// control/control_return_in_loop
// Returning from inside a while loop.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let firstMultiple = fn (of: i32, above: i32) -> i32 {
    let n: mut i32 = above + 1;
    while true {
        if n % of == 0 { return n; }
        n = n + 1;
    }
    return -1;
};

let main = fn (args: [][]u8) -> i32 {
    pi(firstMultiple(7, 20));
    pi(firstMultiple(5, 5));
    return 0;
};
