import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let main = fn (args: [][]u8) -> i32 {
    let x: i32 = #(@noComptime) 4;
    let s = if (x > 3) "big" else "small";
    Console::log(s);
    let y = if (x % 2 == 0) 10 else 20;
    pi(y);
    let z = if (x > 100) 1 else if (x > 3) 2 else 3;
    pi(z);
    return 0;
};
