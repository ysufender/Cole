// control/control_for_array
// for over an array captures a pointer to each element.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let main = fn (args: [][]u8) -> i32 {
    let arr = [4]i32(10, 20, 30, 40);
    let s: mut i32 = 0;
    for arr, |p| {
        s = s + p;
    }
    pi(s);
    return 0;
};
