// control/control_while_break_continue
// break and continue inside while loops.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let main = fn (args: [][]u8) -> i32 {
    let i: mut i32 = 0;
    let sum: mut i32 = 0;
    while i < 10 {
        i = i + 1;
        if i == 3 { continue; }
        if i == 8 { break; }
        sum = sum + i;
    }
    pi(sum);
    pi(i);
    return 0;
};
