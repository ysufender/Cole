import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

code if (buildInfo().backend == @C) "
#source_start
    int const twice_c(int const x) { return x * 2; }
#source_end
" else compileError("This test is for the C backend, on QBE you can ignore this safely.");

let twice_c = #(@extern) fn (x: c_int) -> c_int { };

let main = fn (args: [][]u8) -> i32 {
    pi(cast(twice_c(21)));
    return 0;
};
