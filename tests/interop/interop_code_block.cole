import std::io::console as Console;

let main = fn (args: [][]u8) -> i32 {
    code
        if (buildInfo().backend == @C) "printf(\"raw c block %d\n\", 7); "
        else compileError("This test is for the C backend, on QBE you can safely ignore this.");
    Console::log("after");
    return 0;
};
