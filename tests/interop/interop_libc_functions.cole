// interop/interop_libc_functions
// Declaring and calling libc functions with #(@extern).
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let strlen = #(@extern) fn (s: [@c]c_char) -> c_size { };
let abs = #(@extern) fn (n: c_int) -> c_int { };
let atoi = #(@extern) fn (s: [@c]c_char) -> c_int { };

let main = fn (args: [][]u8) -> i32 {
    pi(cast(strlen("hello")));
    pi(cast(abs(-42)));
    pi(cast(atoi("123")));
    return 0;
};
