// bugs/bug_precedence_documented
// Operator precedence of shifts, & | ^ and % as documented in Appendix II of the language reference.
// KNOWN BUG: the parser implements C-like precedence (see operators/op_precedence_implemented); either the parser or the reference needs to change.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let main = fn (args: [][]u8) -> i32 {
    pi(1 + 2 << 1);
    pi(6 & 3 + 1);
    pi(1 | 2 ^ 3);
    pi(2 * 3 % 4);
    return 0;
};
