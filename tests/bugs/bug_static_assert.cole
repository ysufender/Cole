// bugs/bug_static_assert
// std::debug::staticAssert calls compileError with two arguments but the builtin takes one.
// KNOWN BUG: 'compileError' expects a single expression argument, received 2.
import std::io::console as Console;

import std::debug as Debug;

let main = fn (args: [][]u8) -> i32 {
    Debug::staticAssert("A simple assertion failed", 1 + 1 == 2);
    Debug::staticAssert("ok", 1 + 1 != 2);
    Console::log("ok");
    return 0;
};
