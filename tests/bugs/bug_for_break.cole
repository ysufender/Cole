// bugs/bug_for_break
// break inside a for loop emits a goto to an undefined label.
// KNOWN BUG: C error: label $$anon_Loop_..._End used but not defined.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let main = fn (args: [][]u8) -> i32 {
    let found: mut i32 = -1;
    for 0..10, |i| {
        if i == 6 { found = cast(i); break; }
    }
    pi(found);
    return 0;
};
