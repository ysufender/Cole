import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

import std::c::memory as CMem;

let main = fn (args: [][]u8) -> i32 {
    let src: mut [4]mut u8 = (1, 2, 3, 4);
    let dst: mut [4]mut u8 = (0, 0, 0, 0);
    CMem::copy(dst.ptr, src.ptr, 4);
    pi(dst[0] + dst[1] + dst[2] + dst[3]);
    return 0;
};
