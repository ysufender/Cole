// bugs/bug_slice_of_local_array
// A slice of a local array points at a dangling temporary copy, so writes through it never reach the array.
// KNOWN BUG: a[0..4] slices a temporary copy of the array.
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

let fill = fn (s: []mut i32, v: i32) -> void {
    for 0..s.len, |i| {
        s[i] = v + cast(i);
    }
};

let main = fn (args: [][]u8) -> i32 {
    let a: mut [4]mut i32 = (0, 0, 0, 0);
    fill(a[0..4], 10);
    pi(a[0]);
    pi(a[3]);
    let sl = a[1..3];
    pi(sl.len);
    pi(sl[0]);
    return 0;
};
