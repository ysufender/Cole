import std::io::console as Console;

import std::io::file as File;
import std::io::stream as Stream;
import std::c as C;

let main = fn (args: [][]u8) -> i32 {
    let w = File::Output::open(C::Allocator, if (buildInfo().backend == @C) "build/c/_file_output_test.txt" else "build/qbe/_file_output_test.txt", false, false);
    switch w {
        @Some -> |f| {
            _ = Stream::Output::writeline(File::Output::stream(f), "first line");
            _ = Stream::Output::close(File::Output::stream(f));
            Console::log("written");
        }
        @None -> Console::log("open failed");
    }
    return 0;
};
