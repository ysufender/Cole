// bugs/bug_import_std_root
// Importing the root std module breaks the stdlib own std:: paths, so Option/Result cannot be used.
// KNOWN BUG: Given module 'std' is not imported into the current scope (raised inside std/c/memory.cole).
import std::io::console as Console;
import std::string as String;
import std::c as C;

let pi = fn (n: c_long) -> void {
    Console::log(String::intToStr(n, C::Allocator));
};

import std as Std;

let main = fn (args: [][]u8) -> i32 {
    let o: Std::Option(i32) = (@Some, 5);
    switch o {
        @Some -> |v| pi(v);
        @None -> Console::log("none");
    }
    let n: Std::Option(i32) = (@None, ());
    switch n {
        @Some -> |v| pi(v);
        @None -> Console::log("none");
    }
    return 0;
};
