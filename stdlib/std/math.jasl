    Name:
        std::math
    Public Symbols:
        Epsilon,
        isApprox,
        abs,
        pow,
    Description:
        Contains definitions for mathematical operations. For more
        "theoric" side of the numbers, see std::numeric.
*/

pub let Epsilon = 0.000000119209;

pub let Math = fn (T: type) -> type {
    return struct {
        pub let sign = fn (val: T) -> T {
            return if (val > 0) 1 else -1;
        };

        pub let abs = fn (val: T) -> T {
            return val * sign(val);
        };
    };
};
