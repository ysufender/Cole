let Hasher = fn (T: type, Hasher: type) -> type { return *fn (T, *mut Hasher) -> void; };

pub let Hashable = struct {
    pub let Check = fn (T: type) -> bool {
        switch typeInfo(T) {
            @Union -> return false;
            @Pointer -> |ptr| return switch ptr.size {
                @Slice -> Check(ptr.child),
                else -> false,
            };
            @Array -> |arr| return Check(arr.child);
            @Struct -> |str| {
                for str.fields, |fld| {
                    if !Check(fld.valueType) {
                        return false;
                    }
                }

                return true;
            }
            else -> return true;
        }

        return unreachable();
    };

    pub let Trait = fn (T: type) -> type {
        return
            if (Check(T)) T
            else compileError("Given type does not satisfy the Hashable trait.");
    };
};

pub let hash = fn (T: type, H: type) -> *fn (T) -> usize {
    return fn (arg: T) -> usize {
        let hasher = H::init();
        generic(T, H)(arg, hasher.&);
        return H::finalize(hasher);
    };
};

// pub let generic = fn (T: type, H: type) -> Hasher(Hashable::Trait(T), H) {
pub let generic = fn (T: type, H: type) -> Hasher(T, H) {
    switch typeInfo(T) {
        @Union -> unreachable();

        @Pointer -> |ptr| return fn (arg: T, hasher: *mut H) -> void {
            for arg, |item| {
                generic(ptr.child, H)(item, hasher);
            }
        };

        @Array -> |arr| return fn (arg: T, hasher: *mut H) -> void {
            for arg, |item| {
                generic(arr.child, H)(item, hasher);
            }
        };

        @Struct -> |str| return fn (arg: T, hasher: *mut H) -> void {
            for #(@inline) str.fields, |fld| {
                generic(fld.valueType, H)(field(arg, fld.name), hasher);
            }
        };

        else -> return fn (arg: T, hasher: *mut H) -> void {
            let ptr = as([@c]u8, unsafeCast(arg.&));
            H::writeBytes(hasher, ptr[0..sizeOf(T)]);
        };
    }

    return unreachable();
};

pub let FNV1a64 = struct {
    state: mut usize,

    pub let init = fn () -> mut FNV1a64 {
        return (as(usize, cast(-3750763034362895579)));
    };

    pub let writeBytes = fn (self: *mut FNV1a64, data: []u8) -> void {
        let FNV_prime: usize = 1099511628211;
        for data, |byte| {
            self.state = self.state ^ cast(byte);
            self.state = self.state * FNV_prime;
        }
    };

    pub let finalize = fn (self: FNV1a64) -> usize {
        return self.state;
    };
};
