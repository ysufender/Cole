pub let isDigit = fn (ch: u8) -> bool {
    return '0' <= ch and ch <= '9';
};

pub let isAlpha = fn (ch: u8) -> bool {
    return
        ('a' <= ch and ch <= 'z')
        or ('A' <= ch and ch <= 'Z');
};

pub let isAlphaNumeric = fn (ch: u8) -> bool {
    return isDigit(ch) or isAlpha(ch);
};

pub let isWhitespace = fn (ch: u8) -> bool {
    return
        ch == ' '
        or ch == '\n'
        or ch == '\r'
        or ch == '\0'
        or ch == '\t';
};
