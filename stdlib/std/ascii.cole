pub let NEWLINE = 10;
pub let NULL = 0;

pub let isDigit = fn (ch: u8) -> bool {
    return '0' <= ch and ch <= '9';
};

pub let isAlpha = fn (ch: u8) -> bool {
    return
        ('a' <= ch and ch <= 'z')
        or ('A' <= ch and ch <= 'Z');
};

pub let isWhitespace = fn (ch: u8) -> bool {
    return
        ch == ' '
        or ch == NEWLINE;
};
