code {
    #include <stdio.h>
}

import std::io::stream as Stream;
import std::io::file::ofile as OutputFile;
import std::io::file::ifile as InputFile;
import std::memory::allocator as Allocator;

let FILE = #(@extern) struct { };

let stdout: mut *mut FILE = #(@extern) undefined;
let stdin: mut *mut FILE = #(@extern) undefined;
let stderr: mut *mut FILE = #(@extern) undefined;

pub let StdOut = fn () -> Stream::Output::Stream {
    return (
        stdout,
        OutputFile::write,
        OutputFile::writeline,
        OutputFile::writebuffer,
        noseek,
        noclose,
        OutputFile::flush
    );
};

pub let StdErr = fn () -> Stream::Output::Stream {
    return (
        stderr,
        OutputFile::write,
        OutputFile::writeline,
        OutputFile::writebuffer,
        noseek,
        noclose,
        OutputFile::flush
    );
};

pub let StdIn = fn () -> Stream::Input::Stream {
    return (
        stdin,
        InputFile::read,
        InputFile::readline,
        InputFile::readbuffer,
        noexhaust,
        noseek,
        notell,
        noclose,
    );
};

let noexhaust = fn (stream: *mut void, allocator: Allocator::Allocator) -> Stream::Input::ReadLineResult {
    return undefined;
};


let noseek = fn (stream: *mut void, off: u32) -> Stream::Result {
    return @Ok;
};

let noclose = fn (stream: *mut void) -> Stream::Result {
    return @Ok;
};

let notell = fn (stream: *mut void) -> i32 {
    return 0;
};
