import std::memory::allocator;

let Result = std::memory::allocator::Result;

pub let Allocator = std::memory::allocator::Allocator(undefined, create, destroy, alloc, dealloc, _realloc);

pub let copy = fn (T: type) -> *fn ([]mut T, []T) -> void {
    return fn (to: []mut T, from: []T) -> void {
        _ = memcpy(cast(to.ptr), cast(from.ptr), from.len * sizeOf(T));
    };
};

let create = fn (ctx: *mut void, size: u32) -> Result(*mut void) {
    let res: *mut void = cast(malloc(size));

    return
        if (res == undefined) (@Err, @OutOfMemory)
        else (@Ok, res);
};

let destroy = fn (ctx: *mut void, ptr: *void) -> void {
    free(unsafeCast(ptr));
};

let alloc = fn (ctx: *mut void, count: u32, sizeBytesEach: u32) -> Result([]mut void) {
    let res: [@c]mut void = malloc(count * sizeBytesEach);

    return
        if (res == undefined) (@Err, @OutOfMemory)
        else (@Ok, res[0..count * sizeBytesEach]);
};

let dealloc = fn (ctx: *mut void, ptr: []void) -> void {
    free(unsafeCast(ptr.ptr));
};

let _realloc = fn (ctx: *mut void, ptr: []mut void, nlen: u32, sizeBytesEach: u32) -> Result([]mut void) {
    let res = realloc(ptr.ptr, nlen * sizeBytesEach);

    return
        if (res == undefined) (@Err, @OutOfMemory)
        else (@Ok, res[0..nlen * sizeBytesEach]);
};

let malloc = #(@extern) fn (size: mut c_size) -> mut [@c]mut void { };
let free = #(@extern) fn (ptr: [@c]mut void) -> void { };
let realloc = #(@extern) fn (ptr: [@c]mut void, nlen: c_size) -> mut [@c]mut void { };
let memcpy = #(@extern) fn (dst: mut [@c]mut void, src: mut [@c]void, n: mut c_size) -> mut [@c]mut void { };
