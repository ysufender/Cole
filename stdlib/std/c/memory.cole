code {
    #include <stdlib.h>
}

import std::memory::allocator;

pub let Allocator = std::memory::allocator::RawAllocator(undefined, create, destroy, alloc, free);

let create = fn (ctx: *void, size: u32) -> *void {
    let res: mut [@c]void = undefined;
    code { res = malloc(size); }
    return res;
};

let destroy = fn (ctx: *void, ptr: *void) -> void {
    code { free(ptr); }
};

let alloc = fn (ctx: *void, count: u32, sizeByteEach: u32) -> []void {
    let res: mut [@c]void = undefined;
    code { res = calloc(count, sizeByteEach); }
    return res[0..count];
};

let free = fn (ctx: *void, ptr: [@c]void) -> void {
    code { free(ptr); }
};
