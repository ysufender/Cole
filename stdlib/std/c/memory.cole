import std::memory::allocator;

pub let Allocator = std::memory::allocator::Allocator(undefined, create, destroy, alloc, dealloc, _realloc);

pub let memCopy = fn (to: [@c]mut void, from: [@c]mut void, n: u32) -> void {
    let discard = memcpy(to, from, n);
};

let malloc = #(@extern) fn (size: mut c_size) -> mut [@c]mut void { };
let free = #(@extern) fn (ptr: [@c]mut void) -> void { };
let calloc = #(@extern) fn (nmemb: c_size, size: c_size) -> mut [@c]mut void { };
let realloc = #(@extern) fn (ptr: [@c]mut void, nlen: c_size) -> mut [@c]mut void { };
let memcpy = #(@extern) fn (dst: mut [@c]mut void, src: mut [@c]void, n: mut c_size) -> mut [@c]mut void { };

let create = fn (ctx: *mut void, size: u32) -> *mut void {
    return malloc(size);
};

let destroy = fn (ctx: *mut void, ptr: *mut void) -> void {
    free(ptr);
};

let alloc = fn (ctx: *mut void, count: u32, sizeByteEach: u32) -> []mut void {
    return calloc(count, sizeByteEach)[0..count];
};

let dealloc = fn (ctx: *mut void, ptr: []mut void) -> void {
    free(ptr.ptr);
};

let _realloc = fn (ctx: *mut void, ptr: []mut void, nlen: u32) -> []mut void {
    return realloc(ptr.ptr, nlen)[0..nlen];
};
