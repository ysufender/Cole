import std::memory::allocator;
import std::comparator;
import std::hash;
import std;

let Allocator = std::memory::allocator::Allocator;
let AllocatorResult = std::memory::allocator::Result;
let Option = std::Option;

pub let HashMap = fn (K: type, V: type, Hasher: type, MLP: u32) -> type {
    if !std::hash::Hashable::Check(K) {
        compileError("Given key is not hashable.");
    }

    if MLP >= 100 {
        compileError("Max load percentage should be between 0 and 100 (exclusive).");
    }

    return struct {
        let Self   = this();

        let hashKey = std::hash::hash(K, Hasher);
        let cmpKey  = std::comparator::generic(K);

        let Free      = 0;
        let Used      = 1;
        let Tombstone = 2;

        let MinCap = 16;
        let Status = u8;

        let Entry = struct {
            key   : *K,
            value : *mut V,
        };

        let AdvancedEntry = struct {
            key      : *mut K,
            value    : *mut V,
            metadata : *mut Status,
        };

        keys     : mut []mut K,
        values   : mut []mut V,
        metadata : mut []mut Status,
        size     : mut u32,
        occupied : mut u32,
        capacity : mut u32,

        pub let init = fn (gpa: Allocator) -> Option(mut Self) {
            let self: mut Self = (undefined, undefined, undefined, 0, 0, 0);

            switch Allocator::alloc(K)(gpa, MinCap) {
                @Ok -> |mem| self.keys = mem;
                @Err -> return (@None, ());
            }
            switch Allocator::alloc(V)(gpa, MinCap) {
                @Ok -> |mem| self.values = mem;
                @Err -> {
                    Allocator::dealloc(K)(gpa, self.keys);
                    return (@None, ());
                }
            }
            switch Allocator::alloc(Status)(gpa, MinCap) {
                @Ok -> |mem| self.metadata = mem;
                @Err -> {
                    Allocator::dealloc(K)(gpa, self.keys);
                    Allocator::dealloc(V)(gpa, self.values);
                    return (@None, ());
                }
            }

            self.capacity = MinCap;

            for 0..self.metadata.len, |i| {
                self.metadata[i] = Free;
            }

            return (@Some, self);
        };

        pub let deinit = fn (self: *mut Self, gpa: Allocator) -> void {
            if self.capacity == 0 { return; }

            Allocator::dealloc(K)(gpa, self.keys);
            Allocator::dealloc(V)(gpa, self.values);
            Allocator::dealloc(Status)(gpa, self.metadata);
        };

        pub let contains = fn (self: *mut Self, key: K) -> bool {
            return switch getAdvancedEntry(self, key) {
                @Some -> true,
                @None -> false,
            };
        };

        pub let get = fn (self: *mut Self, key: K) -> Option(*mut V) {
            return switch getAdvancedEntry(self, key) {
                @Some -> |s| (@Some, s.value),
                @None -> (@None, ()),
            };
        };

        pub let remove = fn (self: *mut Self, key: K) -> bool {
            switch getAdvancedEntry(self, key) {
                @Some -> |s| {
                    s.metadata.* = Tombstone;
                    self.size = self.size - 1;
                    return true;
                }
                @None -> { }
            }

            return false;
        };

        pub let getEntry = fn (self: *mut Self, key: K) -> Option(Entry) {
            return switch getAdvancedEntry(self, key) {
                @Some -> |s| (@Some, (s.key, s.value)),
                @None -> (@None, ()),
            };
        };

        pub let put = fn (self: *mut Self, gpa: Allocator, key: K, value: V) -> AllocatorResult(void) {
            if (self.occupied * 100) >= (MLP * self.capacity) {
                switch rehash(self, gpa) {
                    @Ok -> { }
                    @Err -> |err| return (@Err, err);
                }
            }

            let index: mut any = findIndex(self, key);
            
            let hasTombstone: mut bool = false;
            let tombstoneIndex: mut u32 = 0;

            while true {
                let status = self.metadata[index];

                if status == Free {
                    let insertIndex = if (hasTombstone) tombstoneIndex else index;
                    
                    self.keys[insertIndex]     = key;
                    self.values[insertIndex]   = value;
                    self.metadata[insertIndex] = Used;
                    
                    self.size = self.size + 1;
                    if !hasTombstone {
                        self.occupied = self.occupied + 1; 
                    }
                    return (@Ok, ());
                }
                else if status == Tombstone {
                    if !hasTombstone {
                        hasTombstone = true;
                        tombstoneIndex = index;
                    }
                }
                else if status == Used and cmpKey(self.keys[index], key) {
                    self.values[index] = value;
                    return (@Ok, ());
                }

                index = (index + 1) & (self.capacity - 1);
            }

            return unreachable();
        };

        pub let rehash = fn (self: *mut Self, gpa: Allocator) -> AllocatorResult(void) {
            let oldCap = self.capacity;
            let newCap = oldCap * 2;

            let oldKeys   = self.keys;
            let oldValues = self.values;
            let oldMeta   = self.metadata;

            let newKeys: mut []mut K = undefined;
            let newValues: mut []mut V = undefined;
            let newMeta: mut []mut Status = undefined;

            switch Allocator::alloc(K)(gpa, newCap) {
                @Ok -> |mem| newKeys = mem;
                @Err -> |err| return (@Err, err);
            }

            switch Allocator::alloc(V)(gpa, newCap) {
                @Ok -> |mem| newValues = mem;
                @Err -> |err| {
                    Allocator::dealloc(K)(gpa, newKeys);
                    return (@Err, err);
                }
            }

            switch Allocator::alloc(Status)(gpa, newCap) {
                @Ok -> |mem| newMeta = mem;
                @Err -> |err| {
                    Allocator::dealloc(K)(gpa, newKeys);
                    Allocator::dealloc(V)(gpa, newValues);
                    return (@Err, err);
                }
            }

            for 0..newCap, |i| {
                newMeta[i] = Free;
            }
            
            self.keys     = newKeys;
            self.values   = newValues;
            self.metadata = newMeta;
            self.capacity = newCap;
            self.size     = 0;
            self.occupied = 0;

            for 0..oldCap, |i| {
                if oldMeta[i] == Used {
                    _ = put(self, gpa, oldKeys[i], oldValues[i]);
                }
            }

            Allocator::dealloc(K)(gpa, oldKeys);
            Allocator::dealloc(V)(gpa, oldValues);
            Allocator::dealloc(Status)(gpa, oldMeta);

            return (@Ok, ());
        };

        let getAdvancedEntry = fn (self: *mut Self, key: K) -> Option(AdvancedEntry) {
            if self.size == 0 {
                return (@None, ());
            }

            let index: mut any = findIndex(self, key);

            while true {
                let status = self.metadata[index];
                if status == Free {
                    return (@None, ());
                }
                else if status == Used and cmpKey(self.keys[index], key) {
                    return (@Some, self.keys[index].&, self.values[index].&, self.metadata[index].&);
                }

                index = (index + 1) & (self.capacity - 1);
            }

            return (@None, ());
        };

        let findIndex = fn (self: *Self, key: K) -> u32 {
            return as(u32, unsafeCast(hashKey(key))) & (self.capacity - 1);
        };
    };
};
