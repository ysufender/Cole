// @TODO Fix the compiler to somehow do this.

pub let LinkedList = fn (T: type) -> type {
    let Self = union(enum) {
        pub let End = Self(@Nil, ());

        Cons: struct {
            head: T,
            tail: *Self, // @Note Guaranteed to be valid since Nil exists.
        },
        Nil: void,
    };
    return Self;
};
