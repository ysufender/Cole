import std::memory::allocator as Malloc;
import std::c::memory;
import std;

let Allocator = Malloc::Allocator;
let Error = Malloc::Error;
let Res = std::Result;
let Opt = std::Option;

pub let ArrayList = fn (T: type) -> type {
    return struct {
        items   : mut []mut T,
        capacity: mut u32,

        let Self = this();
        let Overhead = 32;

        pub let empty: Self = (undefined, 0);

        pub let init = fn (allocator: Allocator, size: u32) -> Opt(Self) {
            if size == 0 {
                return (@Some, empty);
            }

            let self: mut Self = empty;
            switch allocator.alloc(T)(size) {
                @Ok -> |mem| self.items = mem[0..0];
                else -> return (@None, ());
            }

            self.capacity = size;
            return (@Some, self);
        };

        pub let deinit = fn (self: *mut Self, gpa: Allocator) -> void {
            gpa.dealloc(T)(self.items[0..self.capacity]);
        };

        pub let reserve = fn (self: *mut Self, allocator: Allocator, size: u32) -> Res(void, Error) {
            if self.capacity >= size {
                return (@Ok, ());
            }

            if self.capacity == 0 {
                switch allocator.alloc(T)(size) {
                    @Ok -> |mem| {
                        self.items = mem[0..0];
                        self.capacity = size;
                        return (@Ok, ());
                    }
                    @Err -> |err| return (@Err, err);
                }
            }

            switch allocator.realloc(T)(self.items[0..self.capacity], size) {
                @Ok -> |mem| {
                    self.items = mem[0..self.items.len];
                    self.capacity = size;
                }
                @Err -> |err| return (@Err, err);
            }

            return (@Ok, ());
        };

        pub let append = fn (self: *mut Self, allocator: Allocator, elem: T) -> Res(void, Error) {
            switch addOne(self, allocator) {
                @Ok -> |index| {
                    self.items[index] = elem;
                    return (@Ok, ());
                }
                @Err -> |err| return (@Err, err);
            }

            unreachable();
            return (@Err, @Undefined);
        };

        pub let addOne = fn (self: *mut Self, allocator: Allocator) -> Res(u32, Error) {
            if self.items.len >= self.capacity {
                switch self.reserve(allocator, if (self.capacity == 0) Overhead else self.capacity * 2) {
                    @Ok -> { }
                    @Err -> |err| return (@Err, err);
                }
            }

            let index = self.items.len;
            self.items = self.items[0..index + 1];
            return (@Ok, index);
        };

        pub let remove = fn (self: *mut Self, index: u32) -> bool {
            let len = self.items.len;

            if index >= len {
                return false;
            }

            let i: mut u32 = index;

            while i + 1 < len {
                self.items[i] = self.items[i + 1];
                i = i + 1;
            }

            self.items = self.items[0..len - 1];

            return true;
        };
    };
};
