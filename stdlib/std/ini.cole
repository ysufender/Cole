import std::memory::allocator as Allocator;
import std::io::stream as Stream;

pub let INI = struct {
    allocator: Allocator::Allocator,
    sections: []Section,
};

pub let Section = struct {
    name: []u8,
    values: Pair,
};

pub let Pair = struct {
    name: []u8,
    value: Value,
};

pub let Value = union(enum) {
    Integer  : i32,
    Float    : float,
    String   : []u8,
    Reference: []u8,
    List     : []Value,
};

pub let loadStream = fn (allocator: Allocator::Allocator, stream: Stream::Input::Stream) -> INI {
};
