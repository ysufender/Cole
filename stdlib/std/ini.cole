import std::memory::allocator as Allocator;
import std::io::stream as Stream;
import std::c::memory as Memory;
import std::io::file as File;
import std::ascii as ASCII;

import std::io::console as Console;
import std::string as String;
import std::io as IO;

pub let INI = struct {
    pub let LoadResult = union(enum) {
        Ok: INI,
        Err: void,
    };

    allocator: Allocator::Allocator,
    sections: []Section,
};

pub let Section = struct {
    name: []u8,
    values: []Pair,
};

pub let Pair = struct {
    name: []u8,
    value: Value,
};

pub let Reference = struct {
    Section: []u8,
    Field: []u8,
};

pub let Value = union(enum) {
    Integer  : i32,
    Float    : float,
    String   : []u8,
    Ref      : Reference, 
    List     : []Value,

    pub let print = fn (self: *Value, allocator: Allocator::Allocator, stream: Stream::Output::Stream) -> void {
        if self == undefined {
            _ = Stream::Output::writebuffer(stream, "<undefined>");
            return;
        }

        _ = Stream::Output::writebuffer(stream, switch self.tag {
            @Integer -> |i| String::intToStr(i, allocator),
            @String -> |s| s,
            @Float -> |f| String::floatToStr(f, allocator),
            else -> "<unreachable>",
        });
    };
};

pub let loadFile = fn (allocator: Allocator::Allocator, path: []u8) -> INI::LoadResult {
    let file = File::Input::open(path, allocator, false);

    return switch file {
        @Ok -> |f| loadStream(allocator, File::Input::stream(f)),
        @Err -> (@Err, ()),
    };
};

pub let get = fn (self: *INI, sectionName: mut []u8, fieldName: mut []u8) -> *Value {
    let idx: mut u32 = 0;
    while idx < self.sections.len {
        let section = self.sections[idx].&;
        idx = idx + 1;

        if !String::equals(section.name, sectionName) {
            continue;
        }

        let jdx: mut u32 = 0;
        while jdx < section.values.len {
            let pair = section.values[jdx].&;
            jdx = jdx + 1;

            if !String::equals(pair.name, fieldName) {
                continue;
            }

            if pair.value.tag == @Ref {
                sectionName = pair.value.Ref.Section;
                fieldName = pair.value.Ref.Field;
                jdx = section.values.len;
                idx = 0;
                continue;
            }

            return pair.value.&;
        }
    }

    return undefined;
};

pub let loadStream = fn (allocator: Allocator::Allocator, stream: Stream::Input::Stream) -> INI::LoadResult {
    let list = SectionList::init(allocator);
    let section: mut *mut Section = undefined;
    let values = PairList::init(allocator);

    while true {
        let token = tokenize(allocator, stream);

        switch token.tokenType {
            @Err -> {
                _ = Stream::Output::writebuffer(IO::StdErr(), "Error while tokenizing: ");
                _ = Stream::Output::writeline(IO::StdErr(), token.value);
                return (@Err, ());
            }
            @EOF -> break;
            @Section -> {
                if section != undefined {
                    section.* = (section.name, PairList::slice(values.&, allocator));
                }

                section = SectionList::append(list.&, allocator, token.value);

                if section == undefined {
                    _ = Stream::Output::writebuffer(IO::StdErr(), "Multiple initialization of section: ");
                    _ = Stream::Output::writeline(IO::StdErr(), token.value);
                    return (@Err, ());
                }
            }
            @Identifier -> {
                let key = token.value;

                let eq = tokenize(allocator, stream);
                if eq.tokenType != @Equal {
                    _ = Stream::Output::writebuffer(IO::StdErr(), "Expected '=' after identifier: ");
                    _ = Stream::Output::writeline(IO::StdErr(), key);
                    return (@Err, ());
                }

                let val = tokenize(allocator, stream);
                let value: mut Value = undefined;

                switch val.tokenType {
                    @Integer -> value = (@Integer, String::strToInt(val.value));
                    @String -> value = (@String, val.value);
                    @Float -> value = (@Float, String::strToFloat(val.value));
                    @Identifier -> {
                        let section = val.value;

                        let dot = tokenize(allocator, stream);
                        if dot.tokenType != @Dot {
                            _ = Stream::Output::writebuffer(IO::StdErr(), "Expected '.' after identifier: ");
                            _ = Stream::Output::writeline(IO::StdErr(), section);
                            return (@Err, ());
                        }

                        let fieldToken = tokenize(allocator, stream);
                        if fieldToken.tokenType != @Identifier {
                            _ = Stream::Output::writebuffer(IO::StdErr(), "Expected an identifier after '.'.");
                            return (@Err, ());
                        }

                        let field = fieldToken.value;

                        value = (@Ref, section, field);
                    }
                    else -> {
                        _ = Stream::Output::writebuffer(IO::StdErr(), "Expected value after '=', got: ");
                        _ = Stream::Output::writeline(IO::StdErr(), val.value);
                        return (@Err, ());
                    }
                }

                PairList::append(values.&, allocator, key, value);
            }
            else -> {
                _ = Stream::Output::writebuffer(IO::StdErr(), "Unexpected token: ");
                _ = Stream::Output::writebuffer(IO::StdErr(), token.value);
                _ = Stream::Output::write(IO::StdErr(), ASCII::NEWLINE);
                return (@Err, ());
            }
        }
    }

    if section != undefined {
        section.* = (section.name, PairList::slice(values.&, allocator));
    }

    _ = Stream::Input::close(stream);
    return (@Ok, allocator, SectionList::slice(list.&, allocator));
};

let PairList = struct {
    items: mut []mut Pair,
    capacity: mut u32,

    let initial = 8;

    pub let init = fn (allocator: Allocator::Allocator) -> mut PairList {
        let _new = Allocator::alloc(allocator, initial, sizeOf(Pair));
        let new: mut []mut Pair = cast(_new);
        new = new[0..0];
        return (new, initial);
    };

    pub let grow = fn (self: *mut PairList, allocator: Allocator::Allocator) -> void {
        self.capacity = self.capacity * 2;
        let new: []mut Pair = unsafeCast(Allocator::realloc(allocator, cast(self.items), self.capacity * sizeOf(Pair)));
        self.items = new[0..self.items.len];
    };

    pub let append = fn (self: *mut PairList, allocator: Allocator::Allocator, name: []u8, value: Value) -> void {
        if self.items.len >= self.capacity {
            grow(self, allocator);
        }

        let idx = self.items.len;
        self.items = self.items[0..idx + 1];
        self.items[idx] = (name, value);
    };

    pub let slice = fn (self: *mut PairList, allocator: Allocator::Allocator) -> []Pair {
        let slice = Allocator::alloc(allocator, self.items.len, sizeOf(Pair));
        Memory::copy(cast(slice.ptr), self.items.ptr, self.items.len * sizeOf(Pair));
        self.items = self.items[0..0];
        return unsafeCast(slice);
    };
};


let SectionList = struct {
    items: mut []mut Section,
    capacity: mut u32,

    let initial = 32;

    pub let init = fn (allocator: Allocator::Allocator) -> mut SectionList {
        let _new = Allocator::alloc(allocator, initial, sizeOf(Section));
        let new: mut []mut Section = cast(_new);
        new = new[0..0];
        return (new, initial);
    };

    pub let grow = fn (self: *mut SectionList, allocator: Allocator::Allocator) -> void {
        self.capacity = self.capacity * 2;
        let _new = Allocator::realloc(allocator, cast(self.items), self.capacity * sizeOf(Section));
        let new: []mut Section = cast(_new);
        self.items = new[0..self.items.len];
    };

    pub let append = fn (self: *mut SectionList, allocator: Allocator::Allocator, section: []u8) -> *mut Section {
        {
            for 0..self.items.len, |idx| {
                if String::equals(self.items[idx].name, section) {
                    return undefined;
                }
            }
        }

        if self.items.len >= self.capacity {
            grow(self, allocator);
        }

        let idx = self.items.len;
        self.items = self.items[0..self.items.len + 1];
        self.items[idx] = (section, undefined);
        return self.items[idx].&;
    };

    pub let slice = fn (self: *mut SectionList, allocator: Allocator::Allocator) -> []Section {
        let slice = Allocator::alloc(allocator, self.items.len, sizeOf(Section));
        Memory::copy(cast(slice.ptr), self.items.ptr, self.items.len * sizeOf(Section));
        self.items = self.items[0..0];
        return unsafeCast(slice);
    };
};

let Type = enum {
    Section,
    Integer,
    String,
    Float,
    ListStart,
    ListEnd,
    Comma,
    Equal,
    Identifier,
    Dot,
    EOF,
    Newline,
    Err,

    pub let Name = [13][]u8(
        "Section",
        "Integer",
        "String",
        "Float",
        "ListStart",
        "ListEnd",
        "Comma",
        "Equal",
        "Identifier",
        "Dot",
        "EOF",
        "Newline",
        "Err",
    );
};

let Token = struct {
    tokenType: Type,
    value: []u8,
};

let tokenize = fn (allocator: Allocator::Allocator, stream: Stream::Input::Stream) -> Token {
    while true {
        let _ch: mut any = Stream::Input::read(stream);

        switch _ch {
            @Err -> return (@Err, "Stream Read Error");
            @EOS -> return (@EOF, "EOF");
            else -> { }
        }

        let ch: mut any = _ch.Ok;

        if ch == '[' {
            let sectionName = identifier(allocator, stream);
            if sectionName.tokenType == @Err {
                return sectionName;
            }

            _ch = Stream::Input::read(stream);

            switch _ch {
                @Err -> return (@Err, "Stream Read Error");
                @EOS -> return (@EOF, "EOF in section");
                else -> { }
            }

            let ch: mut any = _ch.Ok;

            if ch != ']' {
                return (@Err, "Expected section name closing.");
            }

            return (@Section, sectionName.value);
        }
        else if ASCII::isDigit(ch) {
            _ = Stream::Input::seek(stream, Stream::Input::tell(stream) - 1);
            return number(allocator, stream);
        }
        else if ASCII::isAlpha(ch) {
            _ = Stream::Input::seek(stream, Stream::Input::tell(stream) - 1);
            return identifier(allocator, stream);
        }
        else if ch == '{' {
            return (@ListStart, "list start");
        }
        else if ch == '}' {
            return (@ListEnd, "list end");
        }
        else if ch == ',' {
            return (@Comma, "comma");
        }
        else if ch == '=' {
            return (@Equal, "equal");
        }
        else if ch == '.' {
            return (@Dot, "dot");
        }
        else if ASCII::isWhitespace(ch) {
            continue;
        }
        else {
            return (@Err, "Unexpected Token in tokenize");
        }

        return (@EOF, "Not implemented.");
    }

    return (@EOF, "Unreachable.");
};

let number = fn (allocator: Allocator::Allocator, stream: Stream::Input::Stream) -> Token {
    let isFloat: mut bool = false;
    let start = Stream::Input::tell(stream);

    while true {
        let _ch = Stream::Input::read(stream);

        switch _ch {
            @Ok -> |ch| if !ASCII::isDigit(ch) {
                if ch == '.' and !isFloat {
                    isFloat = true;
                    continue;
                }
                else if ch == '.' {
                    return (@Err, "Trailing dots are not permitted.");
                }
                else {
                    break;
                }
            }
            @Err -> return (@Err, "Stream Error in number.");
            @EOS -> return (@EOF, "EOF in number.");
        }
    }

    let end = Stream::Input::tell(stream);
    let len = end - start - 1;
    _ = Stream::Input::seek(stream, start);

    let _value = Allocator::alloc(allocator, len, 1);
    let value: []mut u8 = unsafeCast(_value);

    for 0..len, |index| {
        let res = Stream::Input::read(stream);

        switch res {
            @Ok -> value[index] = res.Ok;
            @Err -> return (@Err, "Stream Error in identifier.");
            @EOS -> return (@EOF, "EOF in identifier");
        }
    }

    return
        if (isFloat) (@Float, value)
        else (@Integer, value);
};

let identifier = fn (allocator: Allocator::Allocator, stream: Stream::Input::Stream) -> Token {
    let start = Stream::Input::tell(stream);

    while true {
        let _ch = Stream::Input::read(stream);

        switch _ch {
            @Ok -> |ch| if !ASCII::isAlpha(ch) and ch != '_' {
                break;
            }
            @Err -> return (@Err, "Stream Error in identifier count.");
            @EOS -> return (@EOF, "EOF in identifier count");
        }
    }

    let end = Stream::Input::tell(stream);

    let len = end - start - 1;
    _ = Stream::Input::seek(stream, start);

    let _value = Allocator::alloc(allocator, len, 1);
    let value: []mut u8 = unsafeCast(_value);

    for 0..len, |index| {
        let res = Stream::Input::read(stream);

        switch res {
            @Ok -> |rok| value[index] = rok;
            @Err -> return (@Err, "Stream Error in identifier.");
            @EOS -> return (@EOF, "EOF in identifier");
        }
    }

    return (@Identifier, value);
};
