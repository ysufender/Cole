code {
#ifdef DEBUG
#if defined(WIN32)
#include <intrin.h>
#define BREAKPOINT __debugbreak()
#else
#include <signal.h>
#define BREAKPOINT raise(SIGTRAP)
#endif
#else
#define BREAKPOINT
#endif
}

pub let assert = fn (cnd: bool, msg: []u8) -> void {
    if !cnd {
        // TODO: Message error when IO is implemented
        unreachable();
    }
};

// TODO: function tags for force comptime
pub let staticAssert = #(@comptime) fn (cnd: bool) -> void {
    if !cnd {
        compileError("Assertion failed.", ());
    }
};

pub let breakpoint = fn () -> void {
    code { BREAKPOINT; }
};
