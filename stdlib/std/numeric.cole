    DISCLAIMER:
        The traits and conventions mentioned in this document
        are to be obeyed, otherwise neither Cole STDLib nor the
        compiler can guarantee a well defined program.

    Name:
        std::numeric
    Public Symbols:
        Integer,
        Numeric,
        Signed,
        Unsigned,
        Epsilon,
    Description:
        Contains definitions for mathematical operations. For more
        "theoric" side of the numbers, see std::numeric.
*/

pub let Integer = struct {
    pub let Check = fn (T: type) -> bool {
        return switch typeInfo(T) {
            @Integer -> true,
            @CInt -> true,
            @CUInt -> true,
            @CChar -> true,
            @CUChar -> true,
            @CDouble -> true,
            @CLong -> true,
            @CULong -> true,
            @CShort -> true,
            @CUShort -> true,
            @CSize -> true,
            @ComptimeInt -> true,
            else -> false,
        };
    };
    
    pub let Trait = fn (T: type) -> type {
        if !Check(T) {
            compileError("Given type does not satisfy the Integer traits.", ());
        }

        return T;
    };
};

pub let Floating = struct {
    pub let Check = fn (T: type) -> bool {
        return switch typeInfo(T) {
            @Float -> true,
            @CDouble -> true,
            @ComptimeFloat -> true,
            else -> false,
        };
    };

    pub let Trait = fn (T: type) -> type {
        if !Check(T) {
            compileError("Given type does not satisfy the Floating traits.", ());
        }

        return T;
    };
};

pub let Numeric = struct {
    pub let Check = fn (T: type) -> bool {
        return Integer::Check(T) or Floating::Check(T);
    };

    pub let Trait = fn (T: type) -> type {
        if !Check(T) {
            compileError("Given type does not satisfy the Numeric traits.", ());
        }

        return T;
    };
};

pub let Signed = struct {
    pub let Check = fn (T: type) -> bool {
        return switch typeInfo(T) {
            @Integer -> |i| i.signed,
            @Float -> true,
            @CInt -> true,
            @CChar -> true,
            @CDouble -> true,
            @CLong -> true,
            @CShort -> true,
            @CSize -> true,
            @ComptimeFloat -> true,
            @ComptimeInt -> true,
            else -> false,
        };
    }; 

    pub let Trait = fn (T: type) -> type {
        if !Check(T) {
            compileError("Given type does not satisfy the Signed traits.", ());
        }

        return T;
    };
};

pub let Unsigned = struct {
    pub let Check = fn (T: type) -> bool {
        return Numeric::Check(T) and !Signed::Check(T);
    }; 

    pub let Trait = fn (T: type) -> type {
        if !Check(T) {
            compileError("Given type does not satisfy the Unsigned traits.", ());
        }

        return T;
    };
};
