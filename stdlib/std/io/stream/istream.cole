import std::memory::allocator as Allocator;
import std::io::stream as Stream;

pub let ReadResult = union(enum) {
    Ok: u8,
    Err: void,
};

pub let ReadLineResult = union(enum) {
    Ok: []u8,
    Err: void,
};

pub let IStream = struct {
    context   : *void,
    read      : *fn (*void) -> ReadResult,
    readline  : *fn (*void, Allocator::Allocator) -> ReadLineResult,
    readbuffer: *fn (*void, []mut u8) -> ReadLineResult,
    seek      : *fn (*void, u32) -> Stream::Result,
    close     : *fn (*void) -> Stream::Result,
};

pub let read = fn (self: IStream) -> ReadResult {
    return self.read(self.context);
};

pub let readline = fn (self: IStream, allocator: Allocator::Allocator) -> ReadLineResult {
    return self.readline(self.context, allocator);
};

pub let readbuffer = fn (self: IStream, buffer: []mut u8) -> ReadLineResult {
    return self.readbuffer(self.context, buffer);
};

pub let seek = fn (self: IStream, off: u32) -> Stream::Result {
    return self.seek(self.context, off);
};

pub let close = fn (self: IStream) -> Stream::Result {
    return self.close(self.context);
};
