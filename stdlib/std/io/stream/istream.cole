import std::memory::allocator as Allocator;
import std::io::stream as Stream;

pub let IStream = struct {
    pub let ReadResult = union(enum) {
        Ok: u8,
        Err: void,
        EOS: void,
    };

    pub let ReadLineResult = union(enum) {
        Ok: []mut u8,
        Err: void,
        EOS: void,
    };

    context   : *mut void,
    _read      : *fn (*mut void) -> ReadResult,
    _readline  : *fn (*mut void, Allocator::Allocator) -> ReadLineResult,
    _readbuffer: *fn (*mut void, []mut u8) -> ReadLineResult,
    _exhaust   : *fn (*mut void, Allocator::Allocator) -> ReadLineResult,
    _seek      : *fn (*mut void, u32, Stream::Base) -> Stream::Result,
    _tell      : *fn (*mut void) -> i32,
    _close     : *fn (*mut void) -> Stream::Result,

    pub let read = fn (self: IStream) -> ReadResult {
        return self._read(self.context);
    };

    pub let readline = fn (self: IStream, allocator: Allocator::Allocator) -> ReadLineResult {
        return self._readline(self.context, allocator);
    };

    pub let readbuffer = fn (self: IStream, buffer: []mut u8) -> ReadLineResult {
        return self._readbuffer(self.context, buffer);
    };

    pub let seek = fn (self: IStream, off: u32, base: Stream::Base) -> Stream::Result {
        return self._seek(self.context, off, base);
    };

    pub let tell = fn (self: IStream) -> i32 {
        return self._tell(self.context);
    };

    pub let exhaust = fn (self: IStream, allocator: Allocator::Allocator) -> ReadLineResult {
        return self._exhaust(self.context, allocator);
    };

    pub let close = fn (self: IStream) -> Stream::Result {
        return self._close(self.context);
    };
};
