import std::io::stream as Stream;

pub let OStream = struct {
    context    : *mut void,
    write      : *fn (*mut void, u8) -> Stream::Result,
    writeline  : *fn (*mut void, []u8) -> Stream::Result,
    writebuffer: *fn (*mut void, []u8) -> Stream::Result,
    seek       : *fn (*mut void, u32) -> Stream::Result,
    close      : *fn (*mut void) -> Stream::Result,
    flush      : *fn (*mut void) -> Stream::Result,
};

pub let write = fn (self: OStream, ch: u8) -> Stream::Result {
    return self.write(self.context, ch);
};

pub let writeline = fn (self: OStream, str: []u8) -> Stream::Result {
    return self.writeline(self.context, str);
};

pub let writebuffer = fn (self: OStream, buf: []u8) -> Stream::Result {
    return self.writebuffer(self.context, buf);
};

pub let seek = fn (self: OStream, off: u32) -> Stream::Result {
    return self.seek(self.context, off);
};

pub let close = fn (self: OStream) -> Stream::Result {
    return self.close(self.context);
};

pub let flush = fn (self: OStream) -> Stream::Result {
    return self.flush(self.context);
};
