import std::io::stream as Stream;

pub let OStream = struct {
    context    : *mut void,
    _write      : *fn (*mut void, u8) -> Stream::Result,
    _writeline  : *fn (*mut void, []u8) -> Stream::Result,
    _writebuffer: *fn (*mut void, []u8) -> Stream::Result,
    _seek       : *fn (*mut void, u32, Stream::Base) -> Stream::Result,
    _close      : *fn (*mut void) -> Stream::Result,
    _flush      : *fn (*mut void) -> Stream::Result,

    pub let write = fn (self: OStream, ch: u8) -> Stream::Result {
        return self._write(self.context, ch);
    };

    pub let writeline = fn (self: OStream, str: []u8) -> Stream::Result {
        return self._writeline(self.context, str);
    };

    pub let writebuffer = fn (self: OStream, buf: []u8) -> Stream::Result {
        return self._writebuffer(self.context, buf);
    };

    pub let seek = fn (self: OStream, off: u32, base: Stream::Base) -> Stream::Result {
        return self._seek(self.context, off, base);
    };

    pub let close = fn (self: OStream) -> Stream::Result {
        return self._close(self.context);
    };

    pub let flush = fn (self: OStream) -> Stream::Result {
        return self._flush(self.context);
    };
};
