code {
    int32_t const OFFSET_START   = SEEK_SET;
    int32_t const OFFSET_CURRENT = SEEK_CUR;
    int32_t const OFFSET_END     = SEEK_END;
}

import std::io::stream as Stream;

let OFFSET_START  : c_int = #(@extern) 0;
let OFFSET_CURRENT: c_int = #(@extern) 0;
let OFFSET_END    : c_int = #(@extern) 0;

pub let Base = struct {
    pub let Start   = OFFSET_START;
    pub let Current = OFFSET_CURRENT;
    pub let End     = OFFSET_END;
};
