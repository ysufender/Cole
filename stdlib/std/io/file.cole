code {
    #include <stdio.h>
}

import std::io::file::ifile as ifile;
import std::io::stream as Stream;

pub let Base = struct {
    pub let Start   = 0;
    pub let Current = 1;
    pub let End     = 2;
};

pub let Input = struct {
    pub let OpenResult = ifile::OpenResult;
    pub let File       = ifile::IFile;
    pub let stream     = ifile::stream;
    pub let read       = ifile::read;
    pub let readline   = ifile::readline;
    pub let readbuffer = ifile::readbuffer;
    pub let open       = ifile::open;
};
