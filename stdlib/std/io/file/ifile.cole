code {
    #include <stdio.h>
}

import std::memory::allocator as Allocator;
import std::io::stream as Stream;
import std::io::file as File;
import std::ascii as ASCII;

pub let OpenResult = union(enum) {
    Ok: IFile,
    Err: void,
};

pub let IFile = struct {
    handle: *mut FILE,
};

pub let stream = fn (self: IFile) -> Stream::Input::Stream {
    return (cast(self.handle), read, readline, readbuffer, exhaust, seek, tell, close);
};

let read = fn (handle: *mut void) -> Stream::Input::ReadResult {
    let ch: mut u8 = undefined;
    if fread(ch.&, 1, 1, handle) == 1 {
        return
            if (feof(handle) != 0) (@EOS, ())
            else (@Ok, ch);
    }
    return
        if (feof(handle) != 0) (@EOS, ())
        else (@Err, ());
};

let readline = fn (handle: *mut void, allocator: Allocator::Allocator) -> Stream::Input::ReadLineResult {
    let start = ftell(handle);

    while true {
        let res = read(handle);
        switch res {
            @EOS -> break;
            @Err -> return (@Err, ());
            @Ok  -> if (res.Ok == ASCII::NEWLINE) {
                break;
            }
        }
    }
    let end = ftell(handle);

    let len = end - start - 1;

    if len == 0 {
        return (@EOS, ());
    }

    if fseek(handle, start, File::Base::Start) != 0 {
        return (@Err, ());
    }

    let buffer = Allocator::alloc(allocator, len, 1);
    let res = readbuffer(handle, cast(buffer));

    if fseek(handle, end, File::Base::Start) != 0 {
        return (@Err, ());
    }

    return res;
};

let readbuffer = fn (handle: *mut void, buffer: []mut u8) -> Stream::Input::ReadLineResult {
    let idx: mut u32 = 0;
    while idx < buffer.len {
        let res = read(handle);

        switch res {
            @EOS -> return (@EOS, ());
            @Err -> return (@Err, ());
            @Ok -> {
                buffer[idx] = res.Ok;
                idx = idx + 1;
            }
        }
    }

    return (@Ok, buffer);
};

let exhaust = fn (handle: *mut void, allocator: Allocator::Allocator) -> Stream::Input::ReadLineResult {
    _ = fseek(handle, 0, File::Base::End);
    let size = ftell(handle);

    let mem: []mut u8 = unsafeCast(Allocator::alloc(allocator, size, sizeOf(u8)));
    return readbuffer(handle, mem);
};

let seek = fn (handle: *mut void, pos: u32) -> Stream::Result {
    return
        if (fseek(handle, pos, File::Base::Start) == 0) @Ok
        else @Err;
};

let tell = fn (handle: *mut void) -> i32 {
    return unsafeCast(ftell(handle));
};

let close = fn (handle: *mut void) -> Stream::Result {
    return
        if (fclose(handle) == 0) @Ok
        else @Err;
};

pub let open = fn (_path: []u8, allocator: Allocator::Allocator, readWrite: bool) -> OpenResult {
    let path: mut any = _path;
    let mode: mut any =
        if (readWrite) "r+"
        else "r";

    let res = fopen(cast(path.ptr), cast(mode.ptr));

    return
        if (res == undefined) (@Err, ())
        else (@Ok, res);
};

let FILE = #(@extern) struct { };

let fclose = #(@extern) fn (stream: mut *mut FILE) -> mut c_int { };
let fopen  = #(@extern) fn (path: mut [@c]c_char, mode: mut [@c]c_char) -> mut *mut FILE { };
let fread  = #(@extern) fn (dst: [@c]mut void, size: c_size, count: c_size, file: *mut FILE,) -> mut c_size { };
let ftell  = #(@extern) fn (stream: mut *mut FILE) -> mut c_long { };
let fseek  = #(@extern) fn (stream: mut *mut FILE, offset: mut c_long, whence: mut c_int) -> mut c_int { };
let feof   = #(@extern) fn (stream: mut *mut FILE) -> mut c_int { };
