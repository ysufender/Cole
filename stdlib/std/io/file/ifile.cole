code {
    #include <stdio.h>
}

import std::memory::allocator as Allocator;
import std::io::stream as Stream;
import std::io::file as File;
import std::ascii as ASCII;

import std::io::console as Console;

pub let OpenResult = union(enum) {
    Ok: IFile,
    Err: void,
};

pub let IFile = struct {
    handle: *mut FILE,
};

pub let stream = fn (self: IFile) -> Stream::Input::Stream {
    return (cast(self.handle), read, readline, readbuffer, seek, close, flush);
};

pub let read = fn (handle: *mut void) -> Stream::Input::ReadResult {
    let ch: mut u8 = undefined;
    if fread(ch.&, 1, 1, handle) == 1 {
        return
            if (feof(handle) != 0) (@EOS, ())
            else (@Ok, ch);
    }
    return
        if (feof(handle) != 0) (@EOS, ())
        else (@Err, ());
};

pub let readline = fn (handle: *mut void, allocator: Allocator::Allocator) -> Stream::Input::ReadLineResult {
    let start = ftell(handle);

    while true {
        let res = read(handle);
        if res.tag == @EOS {
            break;
        }
        if res.tag == @Err {
            return (@Err, ());
        }
        if res.Ok == ASCII::NEWLINE {
            break;
        }
    }
    let end = ftell(handle);

    let len = end - start;

    if len == 0 {
        return (@EOS, ());
    }

    if fseek(handle, start, File::Base::Start) != 0 {
        return (@Err, ());
    }

    let buffer = Allocator::alloc(allocator, len, 1);
    let res = readbuffer(handle, cast(buffer));

    return res;
};

pub let readbuffer = fn (handle: *mut void, buffer: []mut u8) -> Stream::Input::ReadLineResult {
    let idx: mut u32 = 0;
    while idx < buffer.len {
        let res = read(handle);
        if res.tag == @EOS {
            return (@EOS, ());
        }
        if res.tag == @Err {
            return (@Err, ());
        }
        buffer[idx] = res.Ok;
        idx = idx + 1;
    }

    return (@Ok, buffer);
};

pub let seek = fn (handle: *mut void, pos: u32) -> Stream::Result {
    return
        if (fseek(handle, pos, File::Base::Start) == 0) @Ok
        else @Err;
};

pub let close = fn (handle: *mut void) -> Stream::Result {
    return
        if (fclose(handle) == 0) @Ok
        else @Err;
};

pub let open = fn (path: []u8, allocator: Allocator::Allocator, readWrite: bool) -> OpenResult {
    let res =
        if (readWrite) fopen(path.ptr, "r+")
        else fopen(path.ptr, "r");

    return
        if (res == undefined) (@Err, ())
        else (@Ok, res);
};

pub let flush = fn (handle: *mut void) -> Stream::Result {
    return
        if (fflush(handle) == 0) @Ok
        else @Err;
};

let FILE = #(@extern) struct { };

let fclose = #(@extern) fn (stream: mut *mut FILE) -> mut c_int { };
let fopen  = #(@extern) fn (path: mut [@c]c_char, mode: mut [@c]c_char) -> mut *mut FILE { };
let fread  = #(@extern) fn (dst: [@c]mut void, size: c_size, count: c_size, file: *mut FILE,) -> mut c_size { };
let ftell  = #(@extern) fn (stream: mut *mut FILE) -> mut c_long { };
let fseek  = #(@extern) fn (stream: mut *mut FILE, offset: mut c_long, whence: mut c_int) -> mut c_int { };
let feof   = #(@extern) fn (stream: mut *mut FILE) -> mut c_int { };
let fflush = #(@extern) fn (stream: mut *mut FILE) -> mut c_int { };
