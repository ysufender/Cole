code {
#header_start
    #include <stdio.h>
#header_end
}

import std::memory::allocator as Allocator;
import std::io::stream as Stream;
import std::io::file as File;
import std::ascii as ASCII;
import std;

pub let IFile = struct {
    handle: *mut FILE,
};

pub let stream = fn (self: IFile) -> Stream::Input {
    return (cast(self.handle), read, readline, readbuffer, exhaust, seek, tell, close);
};

pub let read = fn (handle: *mut void) -> Stream::Input::ReadResult {
    let ch: mut u8 = undefined;
    if fread(cast(ch.&), 1, 1, cast(handle)) == 1 {
        return
            if (feof(cast(handle)) != 0) (@EOS, ())
            else (@Ok, ch);
    }
    return
        if (feof(cast(handle)) != 0) (@EOS, ())
        else (@Err, ());
};

pub let readline = fn (handle: *mut void, allocator: Allocator::Allocator) -> Stream::Input::ReadLineResult {
    let start = ftell(cast(handle));

    while true {
        let res = read(cast(handle));
        switch res {
            @EOS -> break;
            @Err -> return (@Err, ());
            @Ok  -> if (res.Ok == ASCII::NEWLINE) {
                break;
            }
        }
    }
    let end = ftell(cast(handle));

    let len = end - start - 1;

    if len == 0 {
        return (@EOS, ());
    }

    if fseek(cast(handle), start, cast(Stream::Base::Start)) != 0 {
        return (@Err, ());
    }

    let _buffer = Allocator::Allocator::alloc(u8)(allocator, len);

    switch _buffer {
        @Ok -> |buffer| {
            let res = readbuffer(cast(handle), cast(buffer));

            if fseek(cast(handle), end, cast(Stream::Base::Start)) != 0 {
                return (@Err, ());
            }

            return res;
        }
        else -> return (@Err, ());
    }

    unreachable();
    return undefined;
};

pub let readbuffer = fn (handle: *mut void, buffer: []mut u8) -> Stream::Input::ReadLineResult {
    let idx: mut u32 = 0;
    while idx < buffer.len {
        let res = read(cast(handle));

        switch res {
            @EOS -> break;
            @Err -> return (@Err, ());
            @Ok -> {
                buffer[idx] = res.Ok;
                idx = idx + 1;
            }
        }
    }

    return (@Ok, buffer);
};

pub let exhaust = fn (handle: *mut void, allocator: Allocator::Allocator) -> Stream::Input::ReadLineResult {
    _ = fseek(cast(handle), 0, cast(Stream::Base::End));
    let size = ftell(cast(handle));

    if size == 0 {
        return (@Ok, "");
    }

    let _mem = Allocator::Allocator::alloc(u8)(allocator, size);

    switch _mem {
        @Ok -> |mem| {
            return readbuffer(cast(handle), mem);
        }
        else -> { }
    }

    return (@Err, ());
};

pub let seek = fn (handle: *mut void, pos: u32, base: Stream::Base) -> Stream::Result {
    return
        if (fseek(cast(handle), pos, cast(base)) == 0) @Ok
        else @Err;
};

pub let tell = fn (handle: *mut void) -> i32 {
    return unsafeCast(ftell(cast(handle)));
};

pub let close = fn (handle: *mut void) -> Stream::Result {
    return
        if (fclose(cast(handle)) == 0) @Ok
        else @Err;
};

pub let open = fn (_path: []u8, allocator: Allocator::Allocator, readWrite: bool) -> std::Result(IFile, void) {
    let path: mut any = _path;
    let mode: mut any =
        if (readWrite) "r+"
        else "r";

    let res = fopen(cast(path.ptr), cast(mode.ptr));

    return
        if (res == undefined) (@Err, ())
        else (@Ok, res);
};

let FILE = #(@extern) struct { };

let fclose = #(@extern) fn (stream: mut *mut FILE) -> mut c_int { };
let fopen  = #(@extern) fn (path: mut [@c]c_char, mode: mut [@c]c_char) -> mut *mut FILE { };
let fread  = #(@extern) fn (dst: [@c]mut void, size: c_size, count: c_size, file: *mut FILE,) -> mut c_size { };
let ftell  = #(@extern) fn (stream: mut *mut FILE) -> mut c_long { };
let fseek  = #(@extern) fn (stream: mut *mut FILE, offset: mut c_long, whence: mut c_int) -> mut c_int { };
let feof   = #(@extern) fn (stream: mut *mut FILE) -> mut c_int { };

