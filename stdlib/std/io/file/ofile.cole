code {
#header_start
    #include <stdio.h>
#header_end
}

import std::memory::allocator as Allocator;
import std::io::stream as Stream;
import std::io::file as File;
import std::ascii as ASCII;
import std::c::memory;
import std;

pub let OFile = struct {
    handle: *mut FILE,
    dummy: void,

    pub let stream = fn (self: OFile) -> Stream::Output {
        return (cast(self.handle), write, writeline, writebuffer, seek, close, flush);
    };

    pub let open = fn (gpa: Allocator::Allocator, path: mut []u8, append: bool, readWrite: bool) -> std::Option(OFile) {
        switch gpa.allocSentinel(u8)(path.len, '\0') {
            @Ok -> |mem| {
                std::c::memory::copy(unsafeCast(mem.ptr), unsafeCast(path.ptr), path.len);
                path = mem;
            }
            else -> return (@None, ());
        }

        let res =
            if (readWrite and append) fopen(cast(path.ptr), "a+")
            else if (readWrite) fopen(cast(path.ptr), "w+")
            else if (append) fopen(cast(path.ptr), "a")
            else fopen(cast(path.ptr), "w");

        return
            if (res == undefined) (@None, ())
            else (@Some, res, ());
    };
};

pub let write = fn (handle: *mut void, ch: u8) -> Stream::Result {
    return
        if (fwrite(cast(ch.&), 1, 1, cast(handle)) == 1) @Ok
        else @Err;
};

pub let writeline = fn (handle: *mut void, line: []u8) -> Stream::Result {
    if writebuffer(cast(handle), line) == @Ok {
        let ch = '\n';
        return
            if (fwrite(cast(ch.&), 1, 1, cast(handle)) == 1) @Ok
            else @Err;
    }
    return @Err;
};

pub let writebuffer = fn (handle: *mut void, buf: []u8) -> Stream::Result {
    return
        if (fwrite(cast(buf.ptr), 1, buf.len, cast(handle)) == buf.len) @Ok
        else @Err;
};

pub let seek = fn (handle: *mut void, off: u32, base: Stream::Base) -> Stream::Result {
    return
        if (fseek(cast(handle), off, cast(base)) != 0) @Err
        else @Ok;
};

pub let close = fn (handle: *mut void) -> Stream::Result {
    return
        if (fclose(cast(handle)) == 0) @Ok
        else @Err;
};

pub let flush = fn (handle: *mut void) -> Stream::Result {
    return
        if (fflush(cast(handle)) == 0) @Ok
        else @Err;
};

let FILE = #(@extern) struct { };

let fwrite = #(@extern) fn (
    src  : mut [@c]void,
    size : mut c_size,
    count: mut c_size,
    file : mut *mut FILE
) -> mut c_size { };
let fseek  = #(@extern) fn (stream: mut *mut FILE, offset: mut c_long, whence: mut c_int) -> mut c_int { };
let fclose = #(@extern) fn (stream: mut *mut FILE) -> mut c_int { };
let fopen  = #(@extern) fn (path: mut [@c]c_char, mode: mut [@c]c_char) -> mut *mut FILE { };
let fflush = #(@extern) fn (stream: mut *mut FILE) -> mut c_int { };

