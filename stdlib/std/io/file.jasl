code {
    #include <stdio.h>
}

import std::ascii as ascii;

let FILE = #(@extern) struct { };

pub let OpenMode = enum {
    Read,
    Write,
    ReadWrite,
};

pub let File = struct {
    handle: *mut FILE,
};

pub let open = fn (path: []u8, mode: OpenMode) -> File {
    let file: mut *mut FILE = undefined;

    if mode == @Read {
        code { file = fopen(path.ptr, "r"); }
    }
    else if mode == @Write {
        code { file = fopen(path.ptr, "w"); }
    }
    else {
        code { file = fopen(path.ptr, "w+"); }
    }

    return File(file);
};

/* Status and File Actions */
pub let close = fn (file: File) -> void {
    code { fclose(file.handle); }
};

pub let ok = fn (file: File) -> bool {
    let status: mut bool = false;
    code { status = file.handle == NULL; }
    return !status;
};

/* Writing */
pub let println = fn (file: File, line: []u8) -> void {
    code { fprintf(file.handle, "%s\n", line.ptr); }
};

pub let print = fn (file: File, line: []u8) -> void {
    code { fprintf(file.handle, "%s", line.ptr); }
};

pub let writeByte = fn (file: File, byte: u8) -> void {
    code { fwrite(&byte, 1, 1, file.handle); }
};

/* Reading */
pub let read = fn (file: File) -> i32 {
    let res: mut i32 = -1;
    code { res = fgetc(file.handle); }
    return res;
};

/* Positioning */
pub let seek = fn (file: File, pos: u32) -> bool {
    let res: mut bool = false;
    code { res = fseek(file.handle, pos, SEEK_SET) == 0; }
    return res;
};
