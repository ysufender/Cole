import std::io as Io;
import std::io::stream;

let OStream = std::io::stream::Output;

pub let write = fn (msg: []u8) -> void {
    _ = Io::StdOut().writebuffer(msg);
};

pub let log = fn (msg: []u8) -> void {
    _ = Io::StdOut().writeline(msg);
};

pub let info = fn (msg: []u8) -> void {
    _ = Io::StdOut().writebuffer("\x1b[32minfo:\x1b[0m ");
    _ = Io::StdOut().writeline(msg);
};

pub let error = fn (msg: []u8) -> void {
    _ = Io::StdOut().writebuffer("\x1b[31merror:\x1b[0m ");
    _ = Io::StdOut().writeline(msg);
};

pub let warn = fn (msg: []u8) -> void {
    _ = Io::StdOut().writebuffer("\x1b[33mwarning:\x1b[0m ");
    _ = Io::StdOut().writeline(msg);
};
