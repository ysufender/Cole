        println
        print
    description:
        Console I/O utilities.
*/

/* Output */
let printf = #(@extern) fn (msg: [@c]u8) -> void {};

pub let println = fn (msg: []u8) -> void {
    printf(msg.ptr);
    printf("\n");
};

pub let print = fn (msg: []u8) -> void {
    printf(msg.ptr);
};

/* Input */
pub let read = fn () -> i32 {
    let res: mut i32 = 0;
    code { res = fgetc(stdin); }
    return res;
};
