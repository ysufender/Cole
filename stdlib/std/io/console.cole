let printf = #(@extern, @variadic) fn (fmt: mut [@c]c_char) -> c_size { };

pub let log = fn (msg: []u8) -> void {
    printf("%s\n", msg.ptr);
};

pub let info = fn (msg: []u8) -> void {
    printf("\e[32minfo:\e[0m %s\n", msg.ptr);
};

pub let error = fn (msg: []u8) -> void {
    printf("\e[31merror:\e[0m %s\n", msg.ptr);
};

pub let warn = fn (msg: []u8) -> void {
    printf("\e[33mwarning:\e[0m %s\n", msg.ptr);
};
