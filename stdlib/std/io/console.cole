let printf = #(@extern, @variadic) fn (fmt: mut [@c]c_char) -> mut c_int { };

pub let write = fn (msg: []u8) -> void {
    _ = printf("%s", if (msg.len != 0) msg.ptr else "".ptr);
};

pub let log = fn (msg: []u8) -> void {
    _ = printf("%s\n", if (msg.len != 0) msg.ptr else "".ptr);
};

pub let info = fn (msg: []u8) -> void {
    _ = printf("\e[32minfo:\e[0m %s\n", if (msg.len != 0) msg.ptr else "".ptr);
};

pub let error = fn (msg: []u8) -> void {
    _ = printf("\e[31merror:\e[0m %s\n", if (msg.len != 0) msg.ptr else "".ptr);
};

pub let warn = fn (msg: []u8) -> void {
    _ = printf("\e[33mwarning:\e[0m %s\n", if (msg.len != 0) msg.ptr else "".ptr);
};
