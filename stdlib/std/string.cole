import std::memory::allocator as Allocator;

pub let intToStr = fn (num: c_long, allocator: Allocator::Allocator) -> []u8 {
    let tmp: mut any = num;
    let digitCount: mut u32 = 0;
    while tmp != 0 {
        tmp = tmp / 10;
        digitCount = digitCount + 1;
    }

    digitCount = if (digitCount == 0) 1 else digitCount;
    let mem = Allocator::alloc(allocator, digitCount, 1);
    let result: []mut u8 = cast(mem);

    tmp = num;
    let index: mut u32 = digitCount;
    while index > 0 {
        result[index - 1] = '0' + tmp % 10;
        tmp = tmp / 10;
        index = index - 1;
    }

    return cast(result);
};

pub let strToInt = fn (str: []u8) -> c_long {
    let res: mut c_long = 0;
    let index: mut u32 = 0;
    while index < str.len {
        res = (res * 10) + (str[index] - '0');
        index = index + 1;
    }
    return res;
};

// Expects <num>.<num> format.
pub let strToFloat = fn (str: []u8) -> float {
    let base: mut u32 = 0;
    let index: mut u32 = 0;
    while str[index] != '.' {
        base = (base * 10) + (str[index] - '0');
        index = index + 1;
    }
    index = index + 1;

    let decimal: mut float = 0;
    let divisor: mut float = 10;
    while index < str.len {
        decimal = decimal + as(float, cast(str[index] - '0')) / divisor;
        divisor = divisor * 10;
        index = index + 1;
    }

    return as(float, cast(base)) + decimal;
};

pub let floatToStr = fn (num: float, allocator: Allocator::Allocator) -> []u8 {
    let whole: c_long = cast(num);
    let frac: float = num - cast(whole);

    let precision: u32 = 9;
    let multiplier: mut float = 1.0;
    let i: mut u32 = 0;
    while i < precision {
        multiplier = multiplier * 10.0;
        i = i + 1;
    }
    let fracInt: c_long = cast(frac * multiplier);

    let wholeStr: []u8 = intToStr(whole, allocator);
    let fracStr: []u8 = intToStr(fracInt, allocator);

    let padding: u32 = precision - fracStr.len;
    let fracSigLen: mut u32 = fracStr.len;
    while fracSigLen > 1 {
        if fracStr[fracSigLen - 1] != '0' {
            break;
        }
        fracSigLen = fracSigLen - 1;
    }
    let fracLen: u32 = padding + fracSigLen;

    let totalLen: u32 = wholeStr.len + 1 + fracLen;
    let mem = Allocator::alloc(allocator, totalLen, sizeOf(u8));
    let result: []mut u8 = cast(mem);

    let pos: mut u32 = 0;

    let wi: mut u32 = 0;
    while wi < wholeStr.len {
        result[pos] = wholeStr[wi];
        pos = pos + 1;
        wi = wi + 1;
    }

    result[pos] = '.';
    pos = pos + 1;

    let pi: mut u32 = 0;
    while pi < padding {
        result[pos] = '0';
        pos = pos + 1;
        pi = pi + 1;
    }

    let fi: mut u32 = 0;
    while fi < fracSigLen {
        result[pos] = fracStr[fi];
        pos = pos + 1;
        fi = fi + 1;
    }

    return cast(result);
};

pub let equals = fn (str1: []u8, str2: []u8) -> bool {
    if str1.len != str2.len {
        return false;
    }

    let idx: mut u32 = 0;
    while idx < str1.len {
        if str1[idx] != str2[idx] {
            return false;
        }
        idx = idx + 1;
    }

    return true;
};
