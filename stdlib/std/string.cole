import std::memory::allocator as Allocator;
import std::io::console as Console;
import std;

/*
 * PUBLIC
 */

pub let equals = fn (str1: []u8, str2: []u8) -> bool {
    if str1.len != str2.len {
        return false;
    }

    for 0..str1.len, |idx| {
        if str1[idx] != str2[idx] {
            return false;
        }
    }

    return true;
};

pub let toStr = fn (T: type) -> any {
    return fn (arg: T, allocator: Allocator::Allocator) -> std::Option([]u8) {
        return switch typeInfo(T) {
            @Integer -> intToStr(arg, allocator),
            else -> (@None, ()),
        };
    };
};

/*
 * PRIVATE
 */

let intToStr = fn (num: c_long, allocator: Allocator::Allocator) -> std::Option([]u8) {
    let isSigned = num < 0;
    let tmp: mut any = num * (if (isSigned) -1 else 1);
    let digitCount: mut u32 = 0;
    while tmp != 0 {
        tmp = tmp / 10;
        digitCount = digitCount + 1;
    }

    digitCount = if (digitCount == 0) 1 else digitCount + (if (isSigned) 1 else 0);
    let result: []mut u8 = cast(Allocator::alloc(allocator, digitCount + 1, 1));

    if result.ptr == undefined {
        return (@None, ());
    }

    tmp = num * (if (isSigned) -1 else 1);
    let index: mut u32 = digitCount;
    while index > (if (isSigned) 1 else 0) {
        result[index - 1] = '0' + tmp % 10;
        tmp = tmp / 10;
        index = index - 1;
    }
    result[0] = if (num < 0) '-' else result[0];
    result[result.len - 1] = 0;

    return (@Some, result);
};

let strToInt = fn (str: mut []u8) -> c_long {
    let isSigned = str[0] == '-';
    let res: mut c_long = 0;
    for (if (isSigned) 1 else 0)..str.len, |index| {
        res = (res * 10) + (str[index] - '0');
    }
    return res * (if (isSigned) -1 else 1);
};

// Expects [-]<num>.<num> format.
let strToFloat = fn (str: mut []u8) -> float {
    let negative = str[0] == '-';
    if negative {
        str = str[1..str.len];
    }

    let base: mut u32 = 0;
    let index: mut u32 = 0;
    while str[index] != '.' {
        base = (base * 10) + (str[index] - '0');
        index = index + 1;
    }
    index = index + 1;

    let decimal: mut float = 0;
    let divisor: mut float = 10;
    for index..str.len, |idx| {
        decimal = decimal + as(float, cast(str[idx] - '0')) / divisor;
        divisor = divisor * 10;
    }

    return (as(float, cast(base)) + decimal) * (if (negative) -1 else 1);
};

let floatToStr = fn (num: float, allocator: Allocator::Allocator) -> std::Option([]u8) {
    let precision: u32 = 9;
    let negative: bool = num < 0;
    let value: mut c_double = cast(num);
    if negative { value = -value; }

    let special: mut []u8 = "";
    if value != value { special = "nan"; }
    else if value >= 9223372036854775808.0 { special = if (negative) "-inf" else "inf"; }

    if special.len > 0 {
        let text: []mut u8 = cast(Allocator::alloc(allocator, special.len + 1, 1));
        for 0..special.len, |i| {
            text[i] = special[i];
        }
        text[special.len] = 0;
        return (@Some, text[0..special.len]);
    }

    let whole: mut c_ulong = cast(value);
    let frac: mut c_double = value - cast(whole);

    let fracDigits: mut u32 = 0;
    for 0..precision, |i| {
        frac = frac * 10;
        let digit: u32 = cast(frac);
        fracDigits = fracDigits * 10 + digit;
        frac = frac - cast(digit);
    }

    if frac > 0.5 or (frac == 0.5 and fracDigits % 2 == 1) {
        fracDigits = fracDigits + 1;
        if fracDigits == 1000000000 {
            fracDigits = 0;
            whole = whole + 1;
        }
    }

    let wholeDigits: mut u32 = 1;
    let rest: mut c_ulong = whole / 10;
    while rest > 0 {
        wholeDigits = wholeDigits + 1;
        rest = rest / 10;
    }

    let length: u32 = (if (negative) 1 else 0) + wholeDigits + 1 + precision;
    let result: []mut u8 = cast(Allocator::alloc(allocator, length + 1, 1));

    if result.ptr == undefined {
        return (@None, ());
    }

    let pos: mut u32 = length;
    result[pos] = 0;

    for 0..precision, |i| {
        pos = pos - 1;
        result[pos] = '0' + cast(fracDigits % 10);
        fracDigits = fracDigits / 10;
    }

    pos = pos - 1;
    result[pos] = '.';

    pos = pos - 1;
    result[pos] = '0' + cast(whole % 10);
    whole = whole / 10;
    while whole > 0 {
        pos = pos - 1;
        result[pos] = '0' + cast(whole % 10);
        whole = whole / 10;
    }

    if negative { result[0] = '-'; }

    return (@Some, result[0..length]);
};
