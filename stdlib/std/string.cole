import std::memory::allocator as Allocator;
import std::fmt as Fmt;
import std::numeric as Numeric;
import std::io::stream::memorystream as MemStream;
import std;
import std::debug as Debug;

/*
 * PUBLIC
 */

pub let equals = fn (str1: []u8, str2: []u8) -> bool {
    if str1.len != str2.len {
        return false;
    }

    for 0..str1.len, |idx| {
        if str1[idx] != str2[idx] {
            return false;
        }
    }

    return true;
};

pub let toStr = fn (T: type) -> *fn (T, Allocator::Allocator) -> std::Option([]u8) {
    switch typeInfo(T) {
        @Integer -> return fn (arg: T, gpa: Allocator::Allocator) -> std::Option([]u8) {
            return safeIntToStr(cast(arg), (@None, ()), gpa);
        };
        @Float -> return fn (arg: T, gpa: Allocator::Allocator) -> std::Option([]u8) {
            return safeFloatToStr(cast(arg), (@None, ()), gpa);
        };
        @Bool -> return fn (arg: T, gpa: Allocator::Allocator) -> std::Option([]u8) {
            return (@Some, boolToStr(arg));
        };
        @Pointer -> return fn (arg: T, gpa: Allocator::Allocator) -> std::Option([]u8) {
            let info = typeInfo(T).Pointer;
            if info.size == @Slice and (info.child == u8 or info.child == mut u8) {
                return (@Some, arg);
            }
            return (@Some, "<pointer>");
        };
        else -> return fn (arg: T, gpa: Allocator::Allocator) -> std::Option([]u8) {
            return (@None, ());
        };
    }

    return unreachable();
};

pub let toStrSentinel = fn (T: type) -> *fn (T, u8, Allocator::Allocator) -> std::Option([]u8) {
    switch typeInfo(T) {
        @Integer -> return fn (arg: T, end: u8, gpa: Allocator::Allocator) -> std::Option([]u8) {
            return safeIntToStr(cast(arg), (@Some, end), gpa);
        };
        @Float -> return fn (arg: T, end: u8, gpa: Allocator::Allocator) -> std::Option([]u8) {
            return safeFloatToStr(cast(arg), (@Some, end),  gpa);
        };
        @Bool -> return fn (arg: T, end: u8, gpa: Allocator::Allocator) -> std::Option([]u8) {
            return (@Some, boolToStr(arg));
        };
        @Pointer -> return fn (arg: T, end: u8, gpa: Allocator::Allocator) -> std::Option([]u8) {
            let info = typeInfo(T).Pointer;
            if info.size == @Slice and (info.child == u8 or info.child == mut u8) {
                return (@Some, arg);
            }
            return (@Some, "<pointer>");
        };
        else -> return fn (arg: T, end: u8, gpa: Allocator::Allocator) -> std::Option([]u8) {
            return (@None, ());
        };
    }

    return unreachable();
};

pub let intToStr =  fn (num: c_long, gpa: Allocator::Allocator) -> []u8 {
    return safeIntToStr(num, (@None, ()), gpa).Some;
};

pub let floatToStr =  fn (num: float, gpa: Allocator::Allocator) -> []u8 {
    return safeFloatToStr(num, (@None, ()), gpa).Some;
};

pub let safeIntToStr = fn (num: c_long, end: std::Option(u8), gpa: Allocator::Allocator) -> std::Option([]u8) {
    let isSigned = num < 0;
    let tmp: mut c_long = num * (if (isSigned) -1 else 1);
    let digitCount: mut u32 = 0;
    while tmp != 0 {
        tmp = tmp / 10;
        digitCount = digitCount + 1;
    }
    let size: u32 = (if (digitCount == 0) 1 else digitCount) + (if (isSigned) 1 else 0);

    switch end {
        @Some -> |sentinel| switch Allocator::Allocator::allocSentinel(u8)(gpa, size, sentinel) {
            @Ok -> |mem| {
                let stream: mut any = MemStream::init(mem);
                Fmt::format(c_long)(num, MemStream::ostream(stream.&));
                return (@Some, mem);
            }
            @Err -> return (@None, ());
        }
        @None -> switch Allocator::Allocator::alloc(u8)(gpa, size) {
            @Ok -> |mem| {
                let stream: mut any = MemStream::init(mem);
                Fmt::format(c_long)(num, MemStream::ostream(stream.&));
                return (@Some, mem);
            }
            @Err -> return (@None, ());
        }
    }

    unreachable();
    return undefined;
};

pub let safeFloatToStr = fn (num: float, end: std::Option(u8), gpa: Allocator::Allocator) -> std::Option([]u8) {
    let precision: u32 = 9;
    let negative: bool = num < 0;
    let value: mut c_double = cast(num);
    if negative { value = -value; }

    let size: mut u32 = if (negative) 1 else 0;

    if value != value or value >= 9223372036854775808.0 {
        size = size + 3;
    }
    else {
        let whole: mut c_ulong = cast(value);
        let frac: mut c_double = value - cast(whole);

        let fracDigits: mut u32 = 0;
        let i: mut u32 = 0;
        while i < precision {
            frac = frac * 10;
            let digit: u32 = cast(frac);
            fracDigits = fracDigits * 10 + digit;
            frac = frac - cast(digit);
            i = i + 1;
        }

        if frac > 0.5 or (frac == 0.5 and fracDigits % 2 == 1) {
            fracDigits = fracDigits + 1;
            if fracDigits == 1000000000 {
                fracDigits = 0;
                whole = whole + 1;
            }
        }

        let wholeDigits: mut u32 = 1;
        let scan: mut c_ulong = whole / 10;
        while scan > 0 {
            wholeDigits = wholeDigits + 1;
            scan = scan / 10;
        }

        size = size + wholeDigits + 1 + precision;
    }

    switch end {
        @Some -> |sentinel| switch Allocator::Allocator::allocSentinel(u8)(gpa, size, sentinel) {
            @Ok -> |mem| {
                let stream: mut any = MemStream::init(mem);
                Fmt::format(float)(num, MemStream::ostream(stream.&));
                return (@Some, mem);
            }
            @Err -> return (@None, ());
        }

         @None -> switch Allocator::Allocator::alloc(u8)(gpa, size) {
            @Ok -> |mem| {
                let stream: mut any = MemStream::init(mem);
                Fmt::format(float)(num, MemStream::ostream(stream.&));
                return (@Some, mem);
            }
            @Err -> return (@None, ());
        }
    }

    unreachable();
    return undefined;
};

pub let boolToStr = fn (b: bool) -> []u8 {
    return if (b) "true" else "false";
};

pub let strToInt = fn (str: []u8) -> c_long {
    let isSigned = str[0] == '-';
    let res: mut c_long = 0;
    for (if (isSigned) 1 else 0)..str.len, |index| {
        res = (res * 10) + cast(str[index] - '0');
    }
    return res * (if (isSigned) -1 else 1);
};

// Expects [-]<num>.<num> format.
pub let strToFloat = fn (str: mut []u8) -> float {
    let negative = str[0] == '-';
    if negative {
        str = str[1..str.len];
    }

    let base: mut u32 = 0;
    let index: mut u32 = 0;
    while str[index] != '.' {
        base = (base * 10) + cast(str[index] - '0');
        index = index + 1;
    }
    index = index + 1;

    let decimal: mut float = 0;
    let divisor: mut float = 10;
    for index..str.len, |idx| {
        decimal = decimal + as(float, cast(str[idx] - '0')) / divisor;
        divisor = divisor * 10;
    }

    return (as(float, cast(base)) + decimal) * (if (negative) -1.0 else 1.0);
};

pub let strToBool = fn (str: []u8) -> bool {
    return equals(str, "true");
};
