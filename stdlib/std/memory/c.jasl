code {
    #include <stdlib.h>
}

pub let malloc = fn (size: u32) -> *void {
    let res: mut [@c]void = undefined;
    code { res = malloc(size); }
    return res;
};

pub let free = fn (ptr: [@c]void) -> void {
    code { free(ptr); }
};

pub let realloc = fn (ptr: [@c]void, newSize: u32) -> [@c]void {
    let res: mut [@c]void = undefined;
    code { res = realloc(ptr, newSize); }
    return res;
};

pub let calloc = fn (count: u32, sizeByteEach: u32) -> [@c]void {
    let res: mut [@c]void = undefined;
    code { res = calloc(count, sizeByteEach); }
    return res;
};
