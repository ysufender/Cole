    name:
        std::memory::allocator
    public symbols:
        Allocator
    description:
        File operation utilities.
*/

pub let Allocator = struct {
    context: *void,
    create: *fn (*void, u32) -> *void,
    destroy: *fn (*void, *void) -> void,
    alloc: *fn (*void, u32, u32) -> [@c]void,
    free: *fn (*void, [@c]void) -> void,
};
