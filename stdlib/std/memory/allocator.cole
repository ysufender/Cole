import std;

pub let Error = enum {
    OutOfMemory,
    Undefined,
};

pub let Result = fn (T: type) -> type {
    return std::Result(T, Error);
};

pub let Allocator = struct {
    context: *mut void,
    create: *fn (*mut void, u32) -> Result(*mut void),
    destroy: *fn (*mut void, *void) -> void,
    alloc: *fn (*mut void, u32, u32) -> Result([]mut void),
    dealloc: *fn (*mut void, []void) -> void,
    realloc: *fn (*mut void, []mut void, u32, u32) -> Result([]mut void),
};

pub let create = fn (T: type) -> any {
    return fn (self: Allocator) -> Result(*mut T) {
        return switch self.create(self.context, sizeOf(T)) {
            @Ok -> |res| (@Ok, cast(res)),
            @Err -> |err| (@Err, err),
        };
    };
};

pub let destroy = fn (T: type) -> any {
    return fn (self: Allocator, ptr: *T) -> void {
        return self.destroy(self.context, cast(ptr));
    };
};

pub let alloc = fn (T: type) -> any {
    return fn (self: Allocator, count: u32) -> Result([]mut T) {
        return switch self.alloc(self.context, count, sizeOf(T)) {
            @Ok -> |res| (@Ok, cast(res)),
            @Err -> |err| (@Err, err),
        };
    };
};

pub let dealloc = fn (T: type) -> any {
    return fn (self: Allocator, arr: []mut T) -> void {
        return self.dealloc(self.context, cast(arr));
    };
};

pub let realloc = fn (T: type) -> any {
    return fn (self: Allocator, arr: []mut T, nlen: u32) -> Result([]mut T) {
        return switch self.realloc(self.context, cast(arr), nlen, sizeOf(T)) {
            @Ok -> |res| (@Ok, cast(res)),
            @Err -> |err| (@Err, err),
        };
    };
};
