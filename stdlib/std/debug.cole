import builtin;
import std::io::stream as Stream;
import std::io::console as Console;
import std::memory::allocator as Allocator;
import std::string as String;
import std::fmt as Format;
import std::io as Io;
import std::c::process as Process;
import std::c as C;

pub let print = fn (fmt: []u8, T: type) -> any {
    return fn (arg: T) -> void {
        Format::print(fmt, T)(arg, C::Allocator, Io::StdOut());
    };
};

pub let assert = fn (cnd: bool, msg: []u8) -> void {
    if !cnd {
        Console::error(msg);
        unreachable();
    }
};

pub let staticAssert = #(@comptime) fn (cnd: bool, msg: []u8) -> void {
    if !cnd {
        compileError(msg);
    }
};

let raise = #(@extern) fn (sig: c_int) -> c_int { };
let Signal = enum {
    Abort = 6,
    Segfault = 11,
    Interrupt = 2,
    Trap = 5,
};

pub let breakpoint = fn () -> void {
    if buildInfo().platform == @Windows {
        code { __debugbreak(); }
    }
    else {
        _ = raise(cast(Signal::Trap));
    }
};

let _Cole_implicit__stack_trace: mut builtin::StackTrace = #(@extern) undefined;

pub let stackTrace = fn () -> builtin::StackTrace {
    return
        if (buildInfo().optimization == @Og) _Cole_implicit__stack_trace
        else (("unknown", "unknown", 0, 0), undefined);
};

pub let dumpTrace = fn (
    trace: builtin::StackTrace,
    allocator: Allocator::Allocator,
    stream: Stream::Output::Stream
) -> void {
    if buildInfo().optimization == @Og {
        let current: mut any = trace.&;

        _ = Stream::Output::writebuffer(stream, "Trace (most recent call first):\n");
        while current != undefined {
            _ = Stream::Output::writebuffer(stream, "    ");
            _ = Stream::Output::writebuffer(stream, current.frame.function);
            _ = Stream::Output::writebuffer(stream, "@");
            _ = Stream::Output::writebuffer(stream, current.frame.file);
            _ = Stream::Output::writebuffer(stream, ":");
            _ = Stream::Output::writebuffer(stream, String::toStr(c_long)(current.frame.line, allocator));
            _ = Stream::Output::writebuffer(stream, ":");
            _ = Stream::Output::writebuffer(stream, String::toStr(c_long)(current.frame.col, allocator));
            _ = Stream::Output::writebuffer(stream, "\n");
            current = current.next;
        }
    }
};

pub let impossible = fn (T: type) -> any {
    return fn () -> T {
        Console::error("Reached unreachable code.");
        dumpTrace(stackTrace(), C::Allocator, Io::StdErr());
        Process::exit(1);
        return undefined;
    };
};
