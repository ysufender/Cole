pub let Result = fn (Ok: type, Err: type) -> type {
    return union(enum) {
        let Self = this();

        Ok: Ok,
        Err: Err,

        pub let orelse = fn (self: Self, val: Ok) -> Ok {
            return switch self {
                @Ok -> |s| s,
                else -> val,
            };
        };
    };
};

pub let Option = fn (T: type) -> type {
    return union(enum) {
        let Self = this();

        Some: T,
        None: void,

        pub let orelse = fn (self: Self, val: T) -> T {
            return switch self {
                @Some -> |s| s,
                else -> val,
            };
        };
    };
};

pub let Pair = fn (F: type, S: type) -> type {
    return struct {
        first: F,
        second: S,
    };
};
