        compiler can guarantee a well defined program.

    Name:
        std
    Public Symbols:
        Option,
        Result,
        Pair,
        ErrorCode,
        DefaultConstructible,
        Equible,
    Description:
        Defines core utilities for error handling, value generation etc.
*/

pub let Option = fn (T: type) -> type {
    return union(enum) {
        Some: T,
        None: void,
    };
};

pub let Result = fn (T: type, E: type) -> type {
    return union(enum) {
        Ok: T,
        Err: E,
    };
};

// TODO: Improve
pub let Either = fn (T: type, P: type) -> type {
    return union(enum) {
        This: T,
        That: P,
    };
};

pub let Pair = fn (T: type, P: type) -> type {
    return struct {
        first: T,
        second: P,
    };
};

pub let ErrorCode = enum {
    Ok,
    ArgumentError,
    RuntimeError,
};
