pub let Result = fn (Ok: type, Err: type) -> type {
    return union(enum) {
        Ok: Ok,
        Err: Err,
    };
};

pub let Option = fn (T: type) -> type {
    return union(enum) {
        let Self = this();

        Some: T,
        None: void,

        pub let defined = fn (self: Self) -> bool {
            return switch self {
                @Some -> true,
                else -> false,
            };
        };
    };
};

pub let Pair = fn (F: type, S: type) -> type {
    return struct {
        first: F,
        second: S,
    };
};
