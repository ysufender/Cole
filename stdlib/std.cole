pub let Result = fn (Ok: type, Err: type) -> type {
    return union(enum) {
        Ok: Ok,
        Err: Err,
    };
};

pub let Option = fn (T: type) -> type {
    return union(enum) {
        Some: T,
        None: void,
    };
};

pub let Pair = fn (F: type, S: type) -> type {
    return struct {
        first: F,
        second: S,
    };
};
