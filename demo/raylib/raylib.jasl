/*
 * RayLib bindings.
 */

pub let Vector2 = #(@extern) struct {
    pub x: float,
    pub y: float,
};

pub let Color = #(@extern) struct {
    pub r: u8,
    pub g: u8,
    pub b: u8,
    pub a: u8,
};

pub let Rectangle = #(@extern) struct {
    x     : float,
    y     : float,
    width : float,
    height: float,
};

pub let InitWindow = fn (width: i32, height: i32, title: []u8) -> void {
    asm {
        #include "raylib.h"
        InitWindow(width, height, (char const*)title.ptr);
    }
};

pub let WindowShouldClose = fn () -> bool {
    asm {
        #include "raylib.h"
        return WindowShouldClose();
    }
};

pub let CloseWindow = fn () -> void {
    asm {
        #include "raylib.h"
        CloseWindow();
    }
};
