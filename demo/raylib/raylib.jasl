pub let InitWindow = fn (width: i32, height: i32, title: []u8) -> void  { code { InitWindow(width, height, title.ptr); } };
pub let CloseWindow = fn () -> void { code { CloseWindow(); } };
pub let ClearBackground = fn (color: Color) -> void { code { ClearBackground(color); } };
pub let BeginDrawing = fn () -> void { code { BeginDrawing(); } };
pub let EndDrawing = fn () -> void { code { BeginDrawing(); } };
pub let SetTargetFPS = fn (fps: i32 ) -> void { code { SetTargetFPS(fps); } };

pub let IsKeyDown = fn (key: KeyboardKey) -> bool {
    let res: mut bool = false;
    code { res = IsKeyDown(key); }
    return res;
};

pub let DrawCircle = fn (
    centerX: i32,
    centerY: i32,
    radius: float,
    color: Color
) -> void { code { DrawCircle(centerX, centerY, radius, color); } };

pub let DrawText = fn (
    text: []u8,
    posX: i32,
    posY: i32,
    fontSize: i32,
    color: Color
) -> void{ code { DrawText(text.ptr, posX, posY, fontSize, color); } };

pub let DrawRectangle = fn (
    posX: i32,
    posY: i32,
    width: i32,
    height: i32,
    color: Color
) -> void { code { DrawRectangle(posX, posY, width, height, color); } };

pub let WindowShouldClose = fn () -> bool {
    let res: mut bool = false;
    code { res = WindowShouldClose(); }
    return res;
};
