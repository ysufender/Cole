import raylib as rl;
import std::math as m;

let WIDTH  = 640;
let HEIGHT = 480;

let main = fn (args: [][]u8) -> i32 {
	let ply: mut Player = (20, 100, 20, 70, 0);
	let cpu: mut Player = (WIDTH-35, 100, 20, 70, 0);
	let ball: mut Ball = (WIDTH/2.0 - 10.0, 120.0, -5.0, -5.0, 10.0);

	rl::InitWindow(WIDTH, HEIGHT, "Ping pong");
	rl::SetTargetFPS(60);

    while !rl::WindowShouldClose() {
		rl::BeginDrawing();
		rl::ClearBackground(rl::Color::Black);
		rl::DrawRectangle(0, 0, (WIDTH/2), HEIGHT, rl::Color::Black);
		rl::DrawRectangle((WIDTH/2), 0, (WIDTH/2), HEIGHT, rl::Color::White);
		rl::DrawRectangle(ply.x, ply.y, ply.w, ply.h, rl::Color::White);
		rl::DrawRectangle(cpu.x, cpu.y, cpu.w, cpu.h, rl::Color::Black);
        let pscore = intToChar(unsafeCast(ply.score));
        let cscore = intToChar(unsafeCast(cpu.score));
		rl::DrawText(pscore[0..2], (WIDTH/2) - 200, 30, 48, rl::Color::White);
		rl::DrawText(cscore[0..2], (WIDTH/2) + 200, 30, 48, rl::Color::Black);
		
		if
            checkCollision(ply.x, ball.x, ply.y, ball.y, ply.w, ply.h, ball.r)
            or checkCollision(cpu.x, ball.x, cpu.y, ball.y, cpu.w,cpu.h,ball.r) {
			ball.bx = -1.0 * ball.bx;
		}

		// cpu.y = unsafeCast(ball.y * 1.0/cast(m::random(100)));
        cpu.y = cpu.y + (ball.y - cpu.y) * 1/cast(m::random(1000));

		if ball.x < (WIDTH/2) { rl::DrawCircle(cast(ball.x), cast(ball.y), ball.r, rl::Color::White); }
		else { rl::DrawCircle(cast(ball.x), cast(ball.y), ball.r, rl::Color::Black); }
		rl::EndDrawing();

		ball.x = ball.bx + ball.x;
		ball.y = ball.by + ball.y;

		if ball.x < 5 {
			cpu.score = cpu.score + 1;
			ball.x = cast(m::random(as(u32, WIDTH) - cast(ball.r)));
			ball.y = cast(m::random(as(u32, HEIGHT) - cast(ball.r)));
			ball.bx = -5;
			
		}
        else if ball.x > WIDTH - 5 {
			ply.score = ply.score + 1;
			ball.x = cast(m::random(as(u32, WIDTH) - cast(ball.r)));
			ball.y = cast(m::random(as(u32, HEIGHT)  - cast(ball.r)));
			ball.bx = 5;
		}
		if ball.y < 5 {
			ball.by = -ball.by;
		}
        else if ball.y > HEIGHT - 5 {
			ball.by = -(ball.by);
		}
		

		if rl::IsKeyDown(rl::W) or rl::IsKeyDown(rl::UP) {
			if ply.y >= 5 {
			    ply.y = ply.y - 5;
            }
		}
        else if rl::IsKeyDown(rl::S) or rl::IsKeyDown(rl::DOWN) {
			if ply.y <= (HEIGHT-ply.h) {
			    ply.y = ply.y + 5;
            }
		}
	}

	rl::CloseWindow();
	return 0;
};

/*
 * Helpers
 */
let intToChar = fn (a: u8) -> [2]u8 {
    let str: [2]u8 = (48 + a , 0);
	return str;
};

let checkCollision = fn (
    x1: i32,
    x2: float,
    y1: i32,
    y2: float,
    w1: i32,
    h1: i32,
    r: float
) -> bool {
	if
        x1 <= x2 + r and y1 <= y2 + r
        and
		x2 <= x1 + w1 and y2 <= y1 + h1 {
			return true;
		}

    return false;
};

/*
 * Types
 */
let Player = struct {
	x    : mut i32,
    y    : mut i32,
	w    : i32,
	h    : i32,
	score: mut i32,
};

let Ball = struct {
	x: mut float,
    y: mut float,
    bx: mut float,
    by: mut float,
	r: float,
}; 
