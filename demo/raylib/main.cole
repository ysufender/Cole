import std::memory::allocator as Allocator;
import std::string as String;
import std::c as C;

import raylib as RayLib;

/*
 * Types
 */
let Player = struct {
    x    : mut i32,
    y    : mut i32,
    w    : i32,
    h    : i32,
    score: mut u32,
};

let Ball = struct {
    x: mut float,
    y: mut float,
    bx: mut float,
    by: mut float,
    r: float,
}; 

let WIDTH  = 640;
let HEIGHT = 480;

let main = fn (args: [][]u8) -> i32 {
    let ply: mut Player = (20, 100, 20, 70, 0);
    let cpu: mut Player = (WIDTH-35, 100, 20, 70, 0);
    let b: mut Ball = (WIDTH/2.0 - 10.0, 120.0, -5.0, -5.0, 10.0);

    RayLib::InitWindow(WIDTH, HEIGHT, "Pong");
    RayLib::SetTargetFPS(60);

    while !RayLib::WindowShouldClose() {
    	RayLib::BeginDrawing();
    	RayLib::ClearBackground(RayLib::Color::Black);
    	RayLib::DrawRectangle(0, 0, (WIDTH/2), HEIGHT, RayLib::Color::Black);
    	RayLib::DrawRectangle((WIDTH/2), 0, (WIDTH/2), HEIGHT, RayLib::Color::White);
    	RayLib::DrawRectangle(ply.x, ply.y, ply.w, ply.h, RayLib::Color::White);
    	RayLib::DrawRectangle(cpu.x, cpu.y, cpu.w, cpu.h, RayLib::Color::Black);

        let pscore = String::intToStr(ply.score, C::Allocator);
        let cscore = String::intToStr(cpu.score, C::Allocator);
		RayLib::DrawText(cast(pscore.ptr), (WIDTH/2) - 200, 30, 48, RayLib::Color::White);
		RayLib::DrawText(cast(cscore.ptr), (WIDTH/2) + 200, 30, 48, RayLib::Color::Black);

        Allocator::dealloc(C::Allocator, cast(pscore));
        Allocator::dealloc(C::Allocator, cast(cscore));
    	
    	if
            checkCollision(ply.x, b.x, ply.y, b.y, ply.w, ply.h, b.r)
            or checkCollision(cpu.x, b.x, cpu.y, b.y, cpu.w,cpu.h,b.r) {
    		b.bx = as(float, -1.0) * b.bx;
    	}

    	cpu.y = unsafeCast(b.y * 0.8);

    	if b.x < (WIDTH/2) { RayLib::DrawCircle(cast(b.x), cast(b.y), b.r, RayLib::Color::White); }
    	else { RayLib::DrawCircle(cast(b.x), cast(b.y), b.r, RayLib::Color::Black); }
    	RayLib::EndDrawing();

    	b.x = b.bx + b.x;
    	b.y = b.by + b.y;

    	if b.x < 5 {
            cpu.score = cpu.score + 1;
    		b.x = (as(float, cast(WIDTH))/2.0) - b.r;
    		b.y = 120;
    		b.bx = -5;
    		
    	}
        else if b.x > WIDTH - 5 {
            ply.score = ply.score + 1;
    		b.x = (as(float, cast(WIDTH))/2.0) - b.r;
    		b.y = 120;
    		b.bx = 5;
    	}
    	if b.y < 5 {
    		b.by = -b.by;
    	}
        else if b.y > HEIGHT - 5 {
    		b.by = -(b.by);
    	}
    	

    	if RayLib::IsKeyDown(RayLib::KeyboardKey::W) or RayLib::IsKeyDown(RayLib::KeyboardKey::UP) {
    		if ply.y >= 5 {
    		    ply.y = ply.y - 5;
            }
    	}
        else if RayLib::IsKeyDown(RayLib::KeyboardKey::S) or RayLib::IsKeyDown(RayLib::KeyboardKey::DOWN) {
    		if ply.y <= (as(i32, cast(HEIGHT))-ply.h) {
    		    ply.y = ply.y + 5;
            }
    	}
    }

    RayLib::CloseWindow();
    return 0;
};

/*
 * Helpers
 */

let checkCollision = fn (
    x1: i32,
    x2: float,
    y1: i32,
    y2: float,
    w1: i32,
    h1: i32,
    r: float
) -> bool {
    if
        x1 <= x2 + r and y1 <= y2 + r
        and
    	x2 <= x1 + w1 and y2 <= y1 + h1 {
    		return true;
    	}

    return false;
};
