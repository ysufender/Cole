import std::memory::allocator as Allocator;
import std::string as String;
import std::c as C;
import std::ini as INI;
import std::io::console as Console;
import std::math as Math;

import raylib as RayLib;

/*
 * Types
 */
let Player = struct {
    x    : mut float,
    y    : mut float,
    w    : float,
    h    : float,
    score: mut u32,
};

let Ball = struct {
    x: mut float,
    y: mut float,
    bx: mut float,
    by: mut float,
    r: float,
}; 

let main = fn (args: [][]u8) -> i32 {
    let _ini: mut any = INI::loadFile(C::Allocator, "demo/raylib/settings.ini");
    if _ini.tag != @Ok {
        Console::error("Failed to load settings.");
        return 1;
    }
    let ini: mut any = _ini.Ok;

    let WIDTH : mut float = getSettingOrelse(ini.&, "window", "width", 640);
    let HEIGHT: mut float = getSettingOrelse(ini.&, "window", "height", 480);

    let ply: mut Player = (20, 100, 20, 70, 0);
    let cpu: mut Player = (cast(WIDTH-35), 100, 20, 70, 0);
    let b: mut Ball = (WIDTH/2.0 - 10.0, 120.0, -5.0, -5.0, 10.0);

    RayLib::InitWindow(cast(WIDTH), cast(HEIGHT), "Pong");
    RayLib::SetTargetFPS(60);

    while !RayLib::WindowShouldClose() {
        _ini = INI::loadFile(C::Allocator, "demo/raylib/settings.ini");
        if _ini.tag == @Ok {
            ini = _ini.Ok;
        }

    	RayLib::BeginDrawing();
    	RayLib::ClearBackground(RayLib::Color::Black);
    	RayLib::DrawRectangle(0, 0, cast(WIDTH/2), cast(HEIGHT), RayLib::Color::Black);
    	RayLib::DrawRectangle(cast(WIDTH/2), 0, cast(WIDTH/2), cast(HEIGHT), RayLib::Color::White);
    	RayLib::DrawRectangle(cast(ply.x), cast(ply.y), cast(ply.w), cast(ply.h), RayLib::Color::White);
    	RayLib::DrawRectangle(cast(cpu.x), cast(cpu.y), cast(cpu.w), cast(cpu.h), RayLib::Color::Black);

        let pscore = String::intToStr(ply.score, C::Allocator);
        let cscore = String::intToStr(cpu.score, C::Allocator);
		RayLib::DrawText(cast(pscore.ptr), as(u32, cast(WIDTH))/2 - 200, 30, 48, RayLib::Color::White);
		RayLib::DrawText(cast(cscore.ptr), as(u32, cast(WIDTH))/2 + 200, 30, 48, RayLib::Color::Black);
        Allocator::dealloc(C::Allocator, cast(pscore));
        Allocator::dealloc(C::Allocator, cast(cscore));
    	
    	if
            checkCollision(ply.x, b.x, ply.y, b.y, ply.w, ply.h, b.r)
            or checkCollision(cpu.x, b.x, cpu.y, b.y, cpu.w,cpu.h,b.r) {
    		b.bx = as(float, -1.0) * b.bx;
    	}

        let bToCpu = b.y - cpu.y;
        let bToCpuDiffSign = Math::sign(bToCpu);
        let cpuSpeed = getSettingOrelse(ini.&, "cpu", "speed", 5);
        let vel: float = bToCpuDiffSign * cast(cpuSpeed);
        cpu.y = cpu.y + cast(vel);

    	if b.x < (WIDTH/2) { RayLib::DrawCircle(cast(b.x), cast(b.y), b.r, RayLib::Color::White); }
    	else { RayLib::DrawCircle(cast(b.x), cast(b.y), b.r, RayLib::Color::Black); }
    	RayLib::EndDrawing();

    	b.x = b.x + Math::sign(b.bx) * getSettingOrelse(ini.&, "ball", "velocity_x", cast(b.x));
    	b.y = b.y + Math::sign(b.by) * getSettingOrelse(ini.&, "ball", "velocity_y", cast(b.y));

    	if b.x < 5 {
            cpu.score = cpu.score + 1;
    		b.x = ((WIDTH)/2.0) - b.r;
    		b.y = getSettingOrelse(ini.&, "ball", "start_y", 120);
    		b.bx = -5;
    		
    	}
        else if b.x > WIDTH - 5 {
            ply.score = ply.score + 1;
    		b.x = (WIDTH/2.0) - b.r;
    		b.y = 120;
    		b.bx = 5;
    	}
    	if b.y < 5 {
    		b.by = -b.by;
    	}
        else if b.y > HEIGHT - 5 {
    		b.by = -(b.by);
    	}
    	

    	if RayLib::IsKeyDown(RayLib::KeyboardKey::W) or RayLib::IsKeyDown(RayLib::KeyboardKey::UP) {
    		if ply.y >= 5 {
    		    ply.y = ply.y - 5;
            }
    	}
        else if RayLib::IsKeyDown(RayLib::KeyboardKey::S) or RayLib::IsKeyDown(RayLib::KeyboardKey::DOWN) {
    		if ply.y <= (as(float, cast(HEIGHT))-ply.h) {
    		    ply.y = ply.y + 5;
            }
    	}
    }

    RayLib::CloseWindow();
    return 0;
};

let getSettingOrelse = fn (ini: *INI::INI, section: []u8, value: []u8, orelse: u32) -> u32 {
    let _value = INI::get(ini, section, value);

    if _value != undefined {
        switch _value.tag {
            @Integer -> return _value.Integer;
            else -> return orelse; 
        }
    }

    return orelse;
};

/*
 * Helpers
 */

let checkCollision = fn (
    x1: float,
    x2: float,
    y1: float,
    y2: float,
    w1: float,
    h1: float,
    r: float
) -> bool {
    if
        x1 <= x2 + r and y1 <= y2 + r
        and
    	x2 <= x1 + w1 and y2 <= y1 + h1 {
    		return true;
    	}

    return false;
};
