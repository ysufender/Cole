code {
    #include <raylib.h>
}

pub let Color = #(@extern) struct {
    r: u8,
    g: u8,
    b: u8,
    a: u8,

    pub let Black = Color(0, 0, 0, 255);
    pub let White = Color(255, 255, 255, 255);
};

