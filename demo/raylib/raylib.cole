pub let InitWindow = #(@extern) fn (width: c_int, height: c_int, title: [@c]c_char) -> void  { };
pub let CloseWindow = #(@extern) fn () -> void { };
pub let ClearBackground = #(@extern) fn (color: Color) -> void { };
pub let BeginDrawing = #(@extern) fn () -> void { };
pub let EndDrawing = #(@extern) fn () -> void { };
pub let SetTargetFPS = #(@extern) fn (fps: c_int) -> void { };

pub let IsKeyDown = #(@extern) fn (key: c_int) -> bool { };

pub let GetFrameTime = #(@extern) fn () -> float { };

pub let DrawCircle = #(@extern) fn (
    centerX: i32,
    centerY: i32,
    radius: float,
    color: Color
) -> void { };

pub let DrawText = #(@extern) fn (
    text: [@c]c_char,
    posX: c_int,
    posY: c_int,
    fontSize: c_int,
    color: Color
) -> void { };

pub let DrawRectangle = #(@extern) fn (
    posX: c_int,
    posY: c_int,
    width: c_int,
    height: c_int,
    color: Color
) -> void { };

pub let WindowShouldClose = #(@extern) fn () -> mut bool { };
