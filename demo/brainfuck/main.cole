import std::io::console as Console;
import std::io::file as File;
import std::c as C;
import std::ascii as ACII;
import std::memory::allocator as Allocator;
import std::io::stream as Stream;
import std::io as IO;
import std::debug;

import cpu as CPU;

let Ok = 0;
let ArgumentError = 1;
let CompilationError = 2;
let RuntimeError = 3;

let main = fn (args: [][]u8) -> i32 {
    if args.len != 1 {
        Console::log("Expected a single input file.");
        return ArgumentError;
    }

    let path = args[0];
    std::debug::print("Source File: %", ([]u8))((path));

    let count = countBytecodeSize(path);
    if count < 0 {
        return CompilationError;
    }
    else if count > CPU::maxBytecode {
        Console::log("Given code is too big.");
        return CompilationError;
    }
    std::debug::print("Bytecode size: %", (i32))((count));

    let allocator = C::Allocator;

    let bytecode = Allocator::Allocator::alloc(u8)(allocator, count).Ok;
    if bytecode.ptr == undefined {
        Console::log("Failed to allocate bytecode.");
        return CompilationError;
    }

    Console::log("Reading byte code...");
    if !populateBytecode(bytecode, path) {
        Console::log("Failed to read bytecode.");
        return CompilationError;
    }

    Console::log("Initializing CPU...");
    let cpu: mut any = CPU::init(bytecode);

    while CPU::cycle(cpu.&) { }

    Allocator::dealloc(u8)(allocator, bytecode);
    return Ok;
};

let populateBytecode = fn (bytecode: mut []mut u8, path: []u8) -> bool {
    let _source = File::Input::open(path, C::Allocator, false);

    if _source.tag == @Err {
        std::debug::print("Failed to read file at path: %", ([]u8))((path));
        return false;
    }

    let source = File::Input::stream(_source.Ok);


    let idx: mut u32 = 0;
    let _ch: mut any = Stream::Input::read(source);
    while _ch.tag != @EOS {
        let op: u8 = unsafeCast(_ch.Ok);

        if 
            op == '<'
            or op == '['
            or op == ']'
            or op == '>'
            or op == '+'
            or op == '-'
            or op == '.'
            or op == ',' {

            bytecode[idx] = op;
            idx = idx + 1;
        }

        _ch = Stream::Input::read(source);
    }

    _ = Stream::Input::close(source);
    return true;
};

let countBytecodeSize = fn (path: []u8) -> i32 {
    let _source = File::Input::open(path, C::Allocator, false);

    if _source.tag == @Err {
        std::debug::print("Failed to read file at path: %", ([]u8))((path));
        return -1;
    }

    let source = File::Input::stream(_source.Ok);

    let count: mut u32 = 0;
    let _ch: mut any = Stream::Input::read(source);
    while _ch.Ok > 0 {
        let op: u8 = unsafeCast(_ch.Ok);

        if 
            op == '<'
            or op == '['
            or op == ']'
            or op == '>'
            or op == '+'
            or op == '-'
            or op == '.'
            or op == ',' {
            count = count + 1;
        }

        _ch = Stream::Input::read(source);
    }

    _ = Stream::Input::close(source);
    return count;
};
