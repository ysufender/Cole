import std::io::console as Console;
import std::io::file as File;
import std::c as C;
import std::ascii as ACII;
import std::memory::allocator as Allocator;
import std::debug;

import cpu as CPU;

let Ok = 0;
let ArgumentError = 1;
let CompilationError = 2;
let RuntimeError = 3;

let main = fn (args: [][]u8) -> i32 {
    if args.len != 1 {
        Console::println("Expected a single input file.");
        return ArgumentError;
    }

    let path = args[0];
    Console::print("Source File: ");
    Console::println(path);

    let count = countBytecodeSize(path);
    if count < 0 {
        return CompilationError;
    }
    else if count > CPU::maxBytecode {
        Console::println("Given code is too big.");
        return CompilationError;
    }

    let allocator = C::Allocator;

    let tmp = Allocator::alloc(allocator, count, 1)[0..count];
    let bytecode: []mut u8 = unsafeCast(tmp);
    code { if (bytecode.ptr == NULL) } {
        Console::println("Failed to allocate bytecode.");
        code { return 2; }
    }

    if !populateBytecode(bytecode, path) {
        Console::println("Failed to read bytecode.");
        return CompilationError;
    }

    let cpu: mut any = CPU::init(bytecode);

    while CPU::cycle(cpu.&) { }

    Allocator::free(allocator, bytecode.ptr);
    return Ok;
};

let populateBytecode = fn (bytecode: mut []mut u8, path: []u8) -> bool {
    let source = File::open(path, @Read);

    if !File::ok(source) {
        Console::print("Failed to read file at path: ");
        Console::println(path);
        return false;
    }

    let idx: mut u32 = 0;
    let ch: mut i32 = File::read(source);
    while ch >= 0 {
        let op: u8 = unsafeCast(ch);

        if 
            op == '<'
            or op == '['
            or op == ']'
            or op == '>'
            or op == '+'
            or op == '-'
            or op == '.'
            or op == ',' {

            bytecode[idx] = op;
            idx = idx + 1;
        }

        ch = File::read(source);
    }

    File::close(source);
    return true;
};

let countBytecodeSize = fn (path: []u8) -> i32 {
    let source = File::open(path, @Read);

    if !File::ok(source) {
        Console::print("Failed to read file at path: ");
        Console::println(path);
        return -1;
    }

    let count: mut u32 = 0;
    let ch: mut i32 = File::read(source);
    while ch > 0 {
        let op: u8 = unsafeCast(ch);

        if 
            op == '<'
            or op == '['
            or op == ']'
            or op == '>'
            or op == '+'
            or op == '-'
            or op == '.'
            or op == ',' {
            count = count + 1;
        }

        ch = File::read(source);
    }

    File::close(source);
    return count;
};
