// cpu.jasl

import std::io::console as Console;
import std::io::stream as Stream;
import std::io as IO;

pub let maxBytecode: u32 = 15000;
pub let maxMemory: u32 = 15000;

pub let CPU = struct {
    memory: mut [maxMemory]mut u8,
    bytecode: []u8,
    ip: mut u32,
    dp: mut u32,
};

pub let init = fn (bytecode: []u8) -> CPU {
    return CPU(undefined, bytecode, 0, 0);
};

pub let cycle = fn (cpu: *mut CPU) -> bool {
    if cpu.ip >= cpu.bytecode.len {
        return false;
    }

    let op = cpu.bytecode[cpu.ip];

    if op == '<' {
        cpu.dp = cpu.dp - 1;
    }
    else if op == '>' {
        cpu.dp = cpu.dp + 1;
    }
    else if op == '+' {
        cpu.memory[cpu.dp] = cpu.memory[cpu.dp] + 1;
    }
    else if op == '-' {
        cpu.memory[cpu.dp] = cpu.memory[cpu.dp] - 1;
    }
    else if op == '.' {
        _ = Stream::Output::write(IO::StdOut(),  cpu.memory[cpu.dp]);
    }
    else if op == ',' {
        let input = Stream::Input::read(IO::StdIn());
        if input.Ok <= 0 {
            Console::log("Unexpected input.");
            return false;
        }

        cpu.memory[cpu.dp] = unsafeCast(input.Ok);
    }
    else if op == '[' and cpu.memory[cpu.dp] == 0 {
        skipForward(cpu);
    }
    else if op == ']' and cpu.memory[cpu.dp] != 0 {
        skipBackward(cpu);
    }

    cpu.ip = cpu.ip + 1;
    return true;
};

let skipForward = fn (cpu: *mut CPU) -> void {
    let count: mut u32 = 1;
    while count > 0 {
        cpu.ip = cpu.ip + 1;

        let ch = cpu.bytecode[cpu.ip];
        if ch == '[' {
            count = count + 1;
        }
        else if ch == ']' {
            count = count - 1;
        }
    }
};

let skipBackward = fn (cpu: *mut CPU) -> void {
    let count: mut u32 = 1;
    while count > 0 {
        cpu.ip = cpu.ip - 1;

        let ch = cpu.bytecode[cpu.ip];
        if ch == '[' {
            count = count - 1;
        }
        else if ch == ']' {
            count = count + 1;
        }
    }
};
