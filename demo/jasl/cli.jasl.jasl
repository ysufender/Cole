import std::memory::allocator as Allocator;

let Flags = enum {
    Help,
    Version,
    Working,
    MaxErr,
    None,
    Include,
    Backend,
    Link,
    LinkPath,
    Flag,
    Output,
    Optimize,
};

let flags = [26]struct{ flag: []u8, enum: Flags }(
    ("--help", @Help),
    ("-h", @Help),
    ("--debug", @Flag),
    ("-D", @Flag),
    ("--output", @Output),
    ("-o", @Output),
    ("--version", @Version),
    ("-v", @Version),
    ("--working", @Working),
    ("-w", @Working),
    ("--max-err", @MaxErr),
    ("-m", @MaxErr),
    ("--include", @Include),
    ("-I", @Include),
    ("--optimize", @Optimize),
    ("-O", @Optimize),
    ("--link", @Link),
    ("-l", @Link),
    ("--link-dir", @LinkPath),
    ("-L", @LinkPath),
    ("--parse-only", @Flag),
    ("--typecheck-only", @Flag),
    ("--resolve-only", @Flag),
    ("--allow-recursion", @Flag),
    ("--supress-warnings", @Flag),
    ("-s", @Flag),
);

pub let parse = fn (allocator: Allocator::RawAllocator, args: [][]u8) void {
};
